@using ShatteredRealms.Domain.Shared
@using ShatteredRealms.Web.Services
@inject AuthService AuthService
@inject AuthStateService AuthStateService
@inject NavigationManager Navigation
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Shattered Realms</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable">
    <nav class="nav flex-column">

        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All" title="Home">
                <svg class="nav-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M10.707 2.293a1 1 0 0 1 1.414 0l7 7A1 1 0 0 1 19 11h-1v9a1 1 0 0 1-1 1h-4v-5H11v5H7a1 1 0 0 1-1-1v-9H5a1 1 0 0 1-.707-1.707l7-7z"/></svg>
                <span class="nav-label">Home</span>
            </NavLink>
        </div>

        @if (_isAuthenticated)
        {
            <div class="nav-section"><span class="nav-label">Characters</span></div>

            <div class="nav-item nav-item--indented">
                <NavLink class="nav-link" href="/characters" title="My Characters">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    <span class="nav-label">My Characters</span>
                </NavLink>
            </div>

            <div class="nav-section"><span class="nav-label">Community</span></div>

            <div class="nav-item nav-item--indented">
                <NavLink class="nav-link" href="/events" title="Actions">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><circle cx="8" cy="15" r="1" fill="currentColor"/><circle cx="12" cy="15" r="1" fill="currentColor"/><circle cx="16" cy="15" r="1" fill="currentColor"/></svg>
                    <span class="nav-label">Actions</span>
                </NavLink>
            </div>
            <div class="nav-item nav-item--indented">
                <NavLink class="nav-link" href="/my-events" title="My Actions">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><polyline points="9 16 11 18 15 14"/></svg>
                    <span class="nav-label">My Actions</span>
                </NavLink>
            </div>
            <div class="nav-item nav-item--indented">
                <NavLink class="nav-link" href="/announcements" title="Announcements">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7z"/></svg>
                    <span class="nav-label">Announcements</span>
                </NavLink>
            </div>
            <div class="nav-item nav-item--indented">
                <NavLink class="nav-link" href="/documents" title="Documents">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                    <span class="nav-label">Documents</span>
                </NavLink>
            </div>
            <div class="nav-item nav-item--indented">
                <NavLink class="nav-link" href="/forum" title="Forum">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    <span class="nav-label">Forum</span>
                </NavLink>
            </div>
            <div class="nav-item nav-item--indented">
                <NavLink class="nav-link" href="/wiki" title="Wiki">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                    <span class="nav-label">Wiki</span>
                </NavLink>
            </div>

            @if (_isOrganiser && !_isAdmin)
            {
                <div class="nav-section"><span class="nav-label">Management</span></div>

                <div class="nav-item nav-item--indented">
                    <NavLink class="nav-link" href="/characters?all=true" title="All Characters">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        <span class="nav-label">All Characters</span>
                    </NavLink>
                </div>
            }

            @if (_canViewAnalytics)
            {
                <div class="nav-section"><span class="nav-label">Analytics</span></div>

                <div class="nav-item nav-item--indented">
                    <NavLink class="nav-link" href="/analytics" Match="NavLinkMatch.All" title="Event Log">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                        <span class="nav-label">Event Log</span>
                    </NavLink>
                </div>
                <div class="nav-item nav-item--indented">
                    <NavLink class="nav-link" href="/analytics/charts" title="Activity Charts">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                        <span class="nav-label">Activity Charts</span>
                    </NavLink>
                </div>
                <div class="nav-item nav-item--indented">
                    <NavLink class="nav-link" href="/analytics/event-attendances" title="Event Attendances">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><polyline points="23 11 17 17 14 14"/></svg>
                        <span class="nav-label">Event Attendances</span>
                    </NavLink>
                </div>
            }

            @if (_isAdmin)
            {
                <div class="nav-section"><span class="nav-label">Administration</span></div>

                <div class="nav-item nav-item--indented">
                    <NavLink class="nav-link" href="/characters?all=true" title="All Characters">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        <span class="nav-label">All Characters</span>
                    </NavLink>
                </div>
                <div class="nav-item nav-item--indented">
                    <NavLink class="nav-link" href="/users" title="Users">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        <span class="nav-label">Users</span>
                    </NavLink>
                </div>
                <div class="nav-item nav-item--indented">
                    <NavLink class="nav-link" href="/roles" title="Roles">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        <span class="nav-label">Roles</span>
                    </NavLink>
                </div>
                <div class="nav-item nav-item--indented">
                    <NavLink class="nav-link" href="/permissions" title="Permissions">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="15" r="4"/><path d="M10.85 12.15L19 4"/><path d="M18 5l2 2"/><path d="M15 8l2 2"/></svg>
                        <span class="nav-label">Permissions</span>
                    </NavLink>
                </div>
            }

            <div class="nav-section"><span class="nav-label">Account</span></div>

            <div class="nav-item nav-item--indented">
                <NavLink class="nav-link" href="/profile" title="Profile">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    <span class="nav-label">Profile</span>
                </NavLink>
            </div>
            <div class="nav-item nav-item--indented">
                <button class="nav-link btn btn-link text-danger" type="button" title="Sign Out" @onclick="Logout">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                    <span class="nav-label">Sign Out</span>
                </button>
            </div>
        }
        else
        {
            <div class="nav-section"><span class="nav-label">Account</span></div>

            <div class="nav-item nav-item--indented">
                <NavLink class="nav-link" href="/login" title="Sign In">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                    <span class="nav-label">Sign In</span>
                </NavLink>
            </div>
            <div class="nav-item nav-item--indented">
                <NavLink class="nav-link" href="/register" title="Register">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                    <span class="nav-label">Register</span>
                </NavLink>
            </div>
        }

    </nav>
</div>

@code {
    private bool _isAuthenticated;
    private bool _isAdmin;
    private bool _isOrganiser;
    private bool _canViewAnalytics;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        AuthStateService.OnAuthStateChanged += HandleAuthStateChanged;
        await RefreshAuthState();
        StateHasChanged();
    }

    private async Task RefreshAuthState()
    {
        _isAuthenticated = await AuthService.IsAuthenticatedAsync();
        _isAdmin = _isAuthenticated && await AuthService.HasPermissionAsync(Claims.Permissions.Users.View);
        _isOrganiser = _isAuthenticated && await AuthService.HasPermissionAsync(Claims.Permissions.Characters.View);
        _canViewAnalytics = _isAuthenticated && await AuthService.HasPermissionAsync(Claims.Permissions.Analytics.View);
    }

    private async Task HandleAuthStateChanged()
    {
        await RefreshAuthState();
        await InvokeAsync(StateHasChanged);
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        _isAuthenticated = false;
        _isAdmin = false;
        _isOrganiser = false;
        StateHasChanged();
        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
        AuthStateService.OnAuthStateChanged -= HandleAuthStateChanged;
    }
}
