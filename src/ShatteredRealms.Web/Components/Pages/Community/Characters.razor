@page "/characters"
@using ShatteredRealms.Application.DTOs.Characters
@using ShatteredRealms.Application.DTOs.Positions
@using ShatteredRealms.Domain.Shared
@using ShatteredRealms.Web.Services
@inject CharacterClientService CharacterService
@inject AuthService AuthService
@rendermode InteractiveServer

<PageTitle>Characters - Shattered Realms</PageTitle>

<div class="chars-page">

    <div class="chars-header">
        <div class="chars-title-group">
            <h1 class="chars-title">Characters</h1>
            <p class="chars-subtitle">@(_viewAll ? "All member characters" : "Your in-world identities")</p>
        </div>
        <div class="chars-header-actions">
            @if (_canViewAny)
            {
                @if (_viewAll)
                {
                    <button class="chars-btn chars-btn--ghost" @onclick="ToggleView">My Characters</button>
                }
                else
                {
                    <button class="chars-btn chars-btn--secondary" @onclick="ToggleView">All Characters</button>
                }
            }
            @if (_canCreate && !_viewAll)
            {
                <button class="chars-btn chars-btn--primary" @onclick="ShowCreateModal">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    New Character
                </button>
            }
        </div>
    </div>

    @if (_viewAll)
    {
        <div class="chars-filters">
            <div class="filter-row">
                <div class="filter-group">
                    <input class="filter-input" placeholder="Search characters..." @bind="_filterSearch" />
                </div>
                <div class="filter-group">
                    <input class="filter-input" placeholder="Filter by user name..." @bind="_filterUserName" />
                </div>
                <div class="filter-group">
                    <input class="filter-input" placeholder="Filter by nation..." @bind="_filterNation" />
                </div>
                <div class="filter-group">
                    <input class="filter-input" placeholder="Filter by role..." @bind="_filterRole" />
                </div>
                <button class="chars-btn chars-btn--primary" @onclick="ApplyFilters">Apply Filters</button>
            </div>
            <div class="group-row">
                <span class="group-label">Group by:</span>
                <label class="group-option">
                    <input type="radio" name="groupBy" value="none"
                           checked="@(_groupBy == "none")"
                           @onchange="@(() => OnGroupChanged("none"))"/>
                </label>
                <label class="group-option">
                    <input type="radio" name="groupBy" value="user" checked="@(_groupBy == "user")"
                           @onchange="@(() => OnGroupChanged("user"))"/> User
                </label>
                <label class="group-option">
                    <input type="radio" name="groupBy" value="nation" checked="@(_groupBy == "nation")"
                           @onchange="@(() => OnGroupChanged("nation"))" /> Nation
                </label>
                <label class="group-option">
                    <input type="radio" name="groupBy" value="faction" checked="@(_groupBy == "faction")"
                           @onchange="@(() => OnGroupChanged("faction"))" /> Faction
                </label>
            </div>
        </div>
    }

    <LoadingSpinner IsVisible="_loading" Message="Loading characters..." />
    <AlertBanner Message="@_error" />

    @if (!_loading && _characters.Count == 0)
    {
        <div class="chars-empty">
            <svg class="chars-empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <p>@(_viewAll ? "No characters found." : "No characters yet.")</p>
            @if (_canCreate && !_viewAll)
            {
                <button class="chars-btn chars-btn--primary" @onclick="ShowCreateModal">Create your first character</button>
            }
        </div>
    }
    else if (!_loading)
    {
        @if (_groupBy == "none")
        {
            <div class="chars-grid">
                @foreach (var c in _characters)
                {
                    <div class="char-card">
                        <div class="char-card__crest">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                            </svg>
                        </div>
                        <div class="char-card__body">
                            <div class="char-card__name">@c.Name</div>
                            <div class="char-card__nationality">@c.Nationality</div>
                            @if (!string.IsNullOrEmpty(c.Faction))
                            {
                                <div class="char-card__faction">@c.Faction</div>
                            }
                            @if (!string.IsNullOrEmpty(c.PositionName))
                            {
                                <div class="char-card__position">@c.PositionName</div>
                            }
                            <div class="char-card__stats">
                                <span class="char-stat">
                                    <span class="char-stat__label">Level</span>
                                    <span class="char-stat__value">@c.Level</span>
                                </span>
                                <span class="char-stat">
                                    <span class="char-stat__label">XP</span>
                                    <span class="char-stat__value">@c.Experience</span>
                                </span>
                            </div>
                            @if (!string.IsNullOrEmpty(c.OwnerName) && (_canViewAny || _viewAll))
                            {
                                <div class="char-card__owner">Owner: @c.OwnerName</div>
                            }
                        </div>
                        <div class="char-card__actions">
                            @if (_canEdit || c.UserId == _currentUserId)
                            {
                                <button class="char-action-btn" title="Edit" @onclick="() => ShowEditModal(c)">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                    </svg>
                                </button>
                            }
                            @if (_canAssignXp)
                            {
                                <button class="char-action-btn char-action-btn--gold" title="Assign XP"
                                        @onclick="() => ShowXpModal(c)">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polygon
                                            points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                                    </svg>
                                </button>
                            }
                            @if (_canAssignPosition)
                            {
                                <button class="char-action-btn char-action-btn--teal" title="Assign Position"
                                        @onclick="() => ShowPositionModal(c)">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                        <circle cx="9" cy="7" r="4"/>
                                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                                    </svg>
                                </button>
                            }
                            @if (_canAssignNationality)
                            {
                                <button class="char-action-btn char-action-btn--purple" title="Assign Nationality"
                                        @onclick="() => ShowNationalityModal(c)">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                    </svg>
                                </button>
                            }
                            @if (_canAssignFaction)
                            {
                                <button class="char-action-btn char-action-btn--orange" title="Assign Faction"
                                        @onclick="() => ShowFactionModal(c)">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                                        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                                    </svg>
                                </button>
                            }
                            @if (_canViewAny)
                            {
                                <button class="char-action-btn char-action-btn--info" title="View History"
                                        @onclick="() => ShowHistoryModal(c)">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"/>
                                        <polyline points="12 6 12 12 16 14"/>
                                    </svg>
                                </button>
                            }
                            @if (_canDelete || c.UserId == _currentUserId)
                            {
                                <button class="char-action-btn char-action-btn--danger" title="Delete"
                                        @onclick="() => ShowDeleteConfirm(c)">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="3 6 5 6 21 6"/>
                                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                        <path d="M10 11v6"/>
                                        <path d="M14 11v6"/>
                                        <path d="M9 6V4h6v2"/>
                                    </svg>
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            var groups = GetGroupedCharacters();
            <div class="chars-groups">
                @foreach (var group in groups)
                {
                    var groupKey = group.Key;
                    var isExpanded = IsGroupExpanded(groupKey);
                    <div class="char-group">
                        <h3 class="char-group__header">
                            <button class="char-group__toggle" @onclick="() => ToggleGroup(groupKey)">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="char-group__icon">
                                    @if (isExpanded)
                                    {
                                        <polyline points="6 9 12 15 18 9"/>
                                    }
                                    else
                                    {
                                        <polyline points="9 6 15 12 9 18"/>
                                    }
                                </svg>
                            </button>
                            @if (_groupBy == "user")
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="char-group__icon">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                                </svg>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="char-group__icon">
                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                </svg>
                            }
                            @group.Key <span class="char-group__count">@group.Value.Count character(s)</span>
                        </h3>
                        @if (isExpanded)
                        {
                        <div class="chars-grid">
                            @foreach (var character in group.Value)
                            {
                                <div class="char-card">
                                    <div class="char-card__crest">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                        </svg>
                                    </div>
                                    <div class="char-card__body">
                                        <div class="char-card__name">@character.Name</div>
                                        <div class="char-card__nationality">@character.Nationality</div>
                                        @if (!string.IsNullOrEmpty(character.Faction))
                                        {
                                            <div class="char-card__faction">@character.Faction</div>
                                        }
                                        @if (!string.IsNullOrEmpty(character.PositionName))
                                        {
                                            <div class="char-card__position">@character.PositionName</div>
                                        }
                                        <div class="char-card__stats">
                                            <span class="char-stat">
                                                <span class="char-stat__label">Level</span>
                                                <span class="char-stat__value">@character.Level</span>
                                            </span>
                                            <span class="char-stat">
                                                <span class="char-stat__label">XP</span>
                                                <span class="char-stat__value">@character.Experience</span>
                                            </span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(character.OwnerName) && (_canViewAny || _viewAll))
                                        {
                                            <div class="char-card__owner">Owner: @character.OwnerName</div>
                                        }
                                    </div>
                                    <div class="char-card__actions">
                                        @if (_canEdit || character.UserId == _currentUserId)
                                        {
                                            <button class="char-action-btn" title="Edit" @onclick="() => ShowEditModal(character)">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                                </svg>
                                            </button>
                                        }
                                        @if (_canAssignXp)
                                        {
                                            <button class="char-action-btn char-action-btn--gold" title="Assign XP"
                                                    @onclick="() => ShowXpModal(character)">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <polygon
                                                        points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                                                </svg>
                                            </button>
                                        }
                                        @if (_canAssignPosition)
                                         {
                                             <button class="char-action-btn char-action-btn--teal" title="Assign Position"
                                                     @onclick="() => ShowPositionModal(character)">
                                                 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                     <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                                     <circle cx="9" cy="7" r="4"/>
                                                     <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                                                     <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                                                 </svg>
                                             </button>
                                         }
                                         @if (_canAssignNationality)
                                         {
                                             <button class="char-action-btn char-action-btn--purple" title="Assign Nationality"
                                                     @onclick="() => ShowNationalityModal(character)">
                                                 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                     <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                                 </svg>
                                             </button>
                                         }
                                         @if (_canAssignFaction)
                                         {
                                             <button class="char-action-btn char-action-btn--orange" title="Assign Faction"
                                                     @onclick="() => ShowFactionModal(character)">
                                                 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                     <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                                                     <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                                                 </svg>
                                             </button>
                                         }
                                         @if (_canViewAny)
                                        {
                                            <button class="char-action-btn char-action-btn--info" title="View History"
                                                    @onclick="() => ShowHistoryModal(character)">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <circle cx="12" cy="12" r="10"/>
                                                    <polyline points="12 6 12 12 16 14"/>
                                                </svg>
                                            </button>
                                        }
                                        @if (_canDelete || character.UserId == _currentUserId)
                                        {
                                            <button class="char-action-btn char-action-btn--danger" title="Delete"
                                                    @onclick="() => ShowDeleteConfirm(character)">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <polyline points="3 6 5 6 21 6"/>
                                                    <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                                    <path d="M10 11v6"/>
                                                    <path d="M14 11v6"/>
                                                    <path d="M9 6V4h6v2"/>
                                                </svg>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@* ── Create Modal ─────────────────────────────────────────────────────────── *@
@if (_showCreate)
{
    <ModalDialog IsVisible="_showCreate" OnClose="CloseCreate" Title="New Character">
        <ChildContent>

            @if (_createError is not null)
            {
                <div class="form-error-banner">@_createError</div>
            }
            <div class="form-group">
                <label class="form-label">Name</label>
                <input class="form-input" @bind="_createForm.Name" placeholder="Character name" maxlength="128" />
            </div>
            <div class="form-group">
                <label class="form-label">Nationality</label>
                <select class="form-input" @bind="_createForm.Nationality">
                    <option value="">- Select -</option>
                    @foreach (var opt in NationalityOptions)
                    {
                        <option value="@opt">@opt</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Faction</label>
                <select class="form-input" @bind="_createForm.Faction">
                    <option value="">- Select -</option>
                    @foreach (var opt in FactionOptions)
                    {
                        <option value="@opt">@opt</option>
                    }
                </select>
            </div>

        </ChildContent>
        <Footer>
            <button class="chars-btn chars-btn--ghost" @onclick="CloseCreate">Cancel</button>
            <button class="chars-btn chars-btn--primary" @onclick="CreateCharacter" disabled="@_saving">
                @(_saving ? "Creating..." : "Create")
            </button>
        </Footer>
    </ModalDialog>
}

@* ── Assign Nationality Modal ──────────────────────────────── *@
@if (_showNationality && _nationalityTarget is not null)
{
    <ModalDialog IsVisible="_showNationality && _nationalityTarget is not null" OnClose="CloseNationality" Title="@_nationalityTitle" PanelClass="modal-panel--sm">
        <ChildContent>
            @if (_nationalityError is not null)
            {
                <div class="form-error-banner">@_nationalityError</div>
            }
            <div class="form-group">
                <label class="form-label">Nationality</label>
                <select class="form-input" @bind="_selectedNationality">
                    <option value="">- Select -</option>
                    @foreach (var opt in NationalityOptions)
                    {
                        <option value="@opt">@opt</option>
                    }
                </select>
            </div>
        </ChildContent>
        <Footer>
            <button class="chars-btn chars-btn--ghost" @onclick="CloseNationality">Cancel</button>
            <button class="chars-btn chars-btn--primary" @onclick="SubmitNationality" disabled="@_saving">
                @(_saving ? "Saving..." : "Assign")
            </button>
        </Footer>
    </ModalDialog>
}

@* ── Assign Faction Modal ──────────────────────────────── *@
@if (_showFaction && _factionTarget is not null)
{
    <ModalDialog IsVisible="_showFaction && _factionTarget is not null" OnClose="CloseFaction" Title="@_factionTitle" PanelClass="modal-panel--sm">
        <ChildContent>
            @if (_factionError is not null)
            {
                <div class="form-error-banner">@_factionError</div>
            }
            <div class="form-group">
                <label class="form-label">Faction</label>
                <select class="form-input" @bind="_selectedFaction">
                    <option value="">- Select -</option>
                    @foreach (var opt in FactionOptions)
                    {
                        <option value="@opt">@opt</option>
                    }
                </select>
            </div>
        </ChildContent>
        <Footer>
            <button class="chars-btn chars-btn--ghost" @onclick="CloseFaction">Cancel</button>
            <button class="chars-btn chars-btn--primary" @onclick="SubmitFaction" disabled="@_saving">
                @(_saving ? "Saving..." : "Assign")
            </button>
        </Footer>
    </ModalDialog>
}

@* ── History Modal ────────────────────────────────────────────────────────── *@
<ModalDialog IsVisible="_showHistory && _historyTarget is not null" OnClose="CloseHistory" Title="@_historyTitle" PanelClass="modal-panel--lg">
    <ChildContent>
        @if (_historyLoading)
    {
        <div class="chars-loading">
            <div class="chars-spinner"></div><span>Loading...</span></div>
    }
    else if (_historyError is not null)
    {
        <div class="form-error-banner">@_historyError</div>
    }
    else if (_history.Count == 0)
    {
        <p class="history-empty">No history recorded yet.</p>
    }
    else
    {
        <div class="history-list">
            @foreach (var entry in _history)
            {
                var parts = entry.Description.Split(" - ", 2);
                var mainDesc = parts[0];
                var note = parts.Length > 1 ? parts[1] : null;
                <div class="history-entry">
                    <div class="history-entry__meta">
                        <span class="history-entry__date">@entry.Date.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
                        <span class="history-entry__by">@entry.PerformedByName</span>
                    </div>
                    <div class="history-entry__desc">@mainDesc</div>
                    @if (note is not null)
                    {
                        <div class="history-entry__note">@note</div>
                    }
                </div>
            }
        </div>
    }
    </ChildContent>
    <Footer>
        <button class="chars-btn chars-btn--ghost" @onclick="CloseHistory">Close</button>
    </Footer>
</ModalDialog>

@* ── Delete Confirm ───────────────────────────────────────────────────────── *@
<ModalDialog IsVisible="_showDelete && _deleteTarget is not null" OnClose="CloseDelete" Title="Delete Character?" PanelClass="modal-panel--sm">
    <ChildContent>
        <p>Permanently delete <strong>@_deleteTarget?.Name</strong>? This cannot be undone.</p>
    </ChildContent>
    <Footer>
        <button class="chars-btn chars-btn--ghost" @onclick="CloseDelete">Cancel</button>
        <button class="chars-btn chars-btn--danger" @onclick="ConfirmDelete" disabled="@_saving">
            @(_saving ? "Deleting..." : "Delete")
        </button>
    </Footer>
</ModalDialog>



@* ── Edit Modal ───────────────────────────────────────────────────────────── *@
@if (_showEdit && _editTarget is not null)
{
     <ModalDialog IsVisible = "_showEdit && _editTarget is not null" OnClose = "CloseEdit" Title = "Edit Character" >
        <ChildContent>
            @if(_editError is not null)
            {
                <div class ="form-error-banner" > @_editError </div>
            }
            <div class ="form-group">
                <label class ="form-label"> Name </label>
                <input class ="form-input" @bind = "_editForm.Name" placeholder = "Character name" maxlength = "128"/>
            </div>
            <div class ="form-group">
                <label class ="form-label" > Nationality </label>
                <input class ="form-input" @bind = "_editForm.Nationality" placeholder = "Nationality" maxlength = "128"/>
            </div>
            <div class ="form-group">
                <label class ="form-label"> Faction </label>
                <input class ="form-input" @bind = "_editForm.Faction" placeholder = "Faction" maxlength = "128"/>
            </div>
            @if(_canEdit)
            {
                <div class="form-group">
                    <label class="form-label"> Level </label>
                    <input class="form-input" type="number" min="1" @bind="_editAdminForm.Level"/>
                </div>
                <div class ="form-group">
                    <label class ="form-label" > Experience </label>
                    <input class ="form-input" type = "number" min = "0" @bind = "_editAdminForm.Experience"/>
                </div>
            }
        </ChildContent>
        <Footer>
            <button class ="chars-btn chars-btn--ghost" @onclick = "CloseEdit"> Cancel </button>
            <button class ="chars-btn chars-btn--primary" @onclick = "SaveEdit" disabled = "@_saving" >@(_saving ? "Saving..." : "Save") </button>
         </Footer>
     </ModalDialog>
 }

@code {
    [SupplyParameterFromQuery(Name = "all")]
    private bool ShowAll { get; set; }

    private List<CharacterDto> _characters = [];
    private List<CharacterDto> _filteredCharacters = [];
    private bool _loading = true;
    private string? _error;
    private string? _currentUserId;
    private bool _viewAll;

    private bool _canCreate;
    private bool _canEdit;
    private bool _canDelete;
    private bool _canViewAny;
    private bool _canAssignXp;
    private bool _canAssignPosition;

    // Filters
    private string _filterSearch = string.Empty;
    private string _filterUserId = string.Empty;
    private string _filterUserName = string.Empty;
    private string _filterRole = string.Empty;
