@page "/roles"
@using ShatteredRealms.Application.DTOs.Roles
@using ShatteredRealms.Application.DTOs.Permissions
@using ShatteredRealms.Web.Services
@inherits AuthPageBase
@inject RoleService RoleService
@inject PermissionService PermissionService
@rendermode InteractiveServer

<PageTitle>Roles</PageTitle>

<div class="page-header">
    <h1>Roles</h1>
    <button class="btn btn-primary" @onclick="ShowCreateModal">Create Role</button>
</div>

@if (roles == null)
{
    <LoadingSpinner IsVisible="true" Message="Loading roles..." />
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Permissions</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var role in roles)
            {
                <tr>
                    <td>@role.Name</td>
                    <td>@role.Description</td>
                    <td>@role.PermissionClaimValues.Count</td>
                    <td>
                        <button class="btn btn-sm btn-warning" @onclick="() => ShowEditModal(role)">Edit</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => ConfirmDelete(role)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (showModal)
{
<ModalDialog IsVisible="true" OnClose="CloseModal" Title="@(isEdit ? "Edit Role" : "Create Role")" PanelClass="modal-panel--lg">
    <ChildContent>
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            <div class="mb-3">
                <label class="form-label">Name</label>
                <input @bind="currentName" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Description</label>
                <input @bind="currentDescription" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Permissions</label>
                @if (permissions != null)
                {
                    <div class="row">
                        @foreach (var category in permissions.GroupBy(p => p.Category))
                        {
                            <div class="col-md-6">
                                <h6>@category.Key</h6>
                                @foreach (var permission in category)
                                {
                                    <div class="form-check" @key="@permission.Name">
                                        <input class="form-check-input" type="checkbox"
                                               id="perm-@permission.Name"
                                               checked="@selectedPermissionClaimValues.Contains(permission.Name)"
                                               @onchange="(ChangeEventArgs e) => TogglePermission(permission.Name, (bool)e.Value!)"/>
                                        <label class="form-check-label" for="perm-@permission.Name">
                                            <strong>@permission.Name</strong><br />
                                            <small class="text-muted">@permission.Description</small>
                                        </label>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
    </ChildContent>
        <Footer>
            <button type="button" class="btn btn-secondary" @onclick="CloseModal">Close</button>
            <button type="button" class="btn btn-primary" @onclick="SaveRole">Save</button>
        </Footer>
    </ModalDialog>
}
@if (_showDeleteConfirm)
{
    <ModalDialog IsVisible="_showDeleteConfirm" OnClose="() => _showDeleteConfirm = false" Title="Delete Role" PanelClass="modal-panel--narrow">
        <ChildContent>

            <p style="font-family: var(--font-body); color: var(--text-muted);">
                Are you sure you want to delete <strong style="color: var(--text)">@_RoleToDelete?.Name</strong>?
                This action cannot be undone.
            </p>


        </ChildContent>
        <Footer>
            <button class="btn-secondary" @onclick="() => _showDeleteConfirm = false">Cancel</button>
            <button class="btn-danger" @onclick="DeleteRole" disabled="@_deleting">
                @(_deleting ? "Deleting..." : "Delete Role")
            </button>
        </Footer>
    </ModalDialog>
}
@code {
    private List<RoleDto>? roles;
    private List<PermissionDto>? permissions;
    private bool showModal = false;
    private bool isEdit = false;
    private string? currentRoleId;
    private string currentName = string.Empty;
    private string currentDescription = string.Empty;
    private List<string> selectedPermissionClaimValues = new();
    private string? errorMessage;
    private bool _showDeleteConfirm;
    private RoleDto _RoleToDelete;
    private bool _deleting;

    protected override async Task OnAuthenticatedAsync()
    {
        await LoadRoles();
        await LoadPermissions();
    }

    private async Task LoadRoles()
    {
        try
        {
            roles = await RoleService.GetAllRolesAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task LoadPermissions()
    {
        try
        {
            permissions = await PermissionService.GetAllPermissionsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void ShowCreateModal()
    {
        isEdit = false;
        currentRoleId = null;
        currentName = string.Empty;
        currentDescription = string.Empty;
        selectedPermissionClaimValues.Clear();
        errorMessage = null;
        showModal = true;
    }

    private void ShowEditModal(RoleDto role)
    {
        isEdit = true;
        currentRoleId = role.Id;
        currentName = role.Name;
        currentDescription = role.Description;
        selectedPermissionClaimValues = new List<string>(role.PermissionClaimValues);
        errorMessage = null;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private void TogglePermission(string claimValue, bool isChecked)
    {
        if (isChecked && !selectedPermissionClaimValues.Contains(claimValue))
        {
            selectedPermissionClaimValues.Add(claimValue);
        }
        else if (!isChecked && selectedPermissionClaimValues.Contains(claimValue))
        {
            selectedPermissionClaimValues.Remove(claimValue);
        }
    }

    private async Task SaveRole()
    {
        try
        {
            errorMessage = null;

            if (isEdit && !string.IsNullOrEmpty(currentRoleId))
            {
                var updateRequest = new UpdateRoleRequest
                {
                    Name = currentName,
                    Description = currentDescription,
                    PermissionClaimValues = selectedPermissionClaimValues
                };

                await RoleService.UpdateRoleAsync(currentRoleId, updateRequest);
            }
            else
            {
                var createRequest = new CreateRoleRequest
                {
                    Name = currentName,
                    Description = currentDescription,
                    PermissionClaimValues = selectedPermissionClaimValues
                };

                await RoleService.CreateRoleAsync(createRequest);
            }

            await LoadRoles();
            CloseModal();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task DeleteRole()
    {
        if (_RoleToDelete == null)
        {
            errorMessage = "No role selected for deletion.";
            return;
        }
        try
        {
            await RoleService.DeleteRoleAsync(_RoleToDelete.Id);
            _showDeleteConfirm = false;
            await LoadRoles();

        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void ConfirmDelete(RoleDto role)
    {
        _showDeleteConfirm = true;
        _RoleToDelete = role;
    }
    
}
