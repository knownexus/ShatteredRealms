@page "/users"
@using ShatteredRealms.Application.DTOs.Auth
@using ShatteredRealms.Application.DTOs.Users
@using ShatteredRealms.Application.DTOs.Roles
@using ShatteredRealms.Web.Services
@inherits AuthPageBase
@inject UserService UserService
@inject RoleService RoleService
@rendermode InteractiveServer

<PageTitle>Users</PageTitle>

<div class="page-header">
    <h1>Users</h1>
    <button class="btn btn-primary" @onclick="ShowCreateModal">Create User</button>
</div>

@if (!string.IsNullOrEmpty(errorMessage) && !string.IsNullOrEmpty(errorCode))
{
    <AlertBanner Message="@($"Error: {errorMessage} ({errorCode})")" />
}

@if (pendingUsers is { Count: > 0 })
{
    <div class="card mb-4" style="border-color: rgba(201,168,76,0.4);">
        <div class="card-header" style="background: rgba(201,168,76,0.08); border-color: rgba(201,168,76,0.4);">
            <h5 class="mb-0">
                Pending Approval
                <span class="badge" style="background: var(--gold); color: #07090f; margin-left: 0.5rem;">@pendingUsers.Count</span>
            </h5>
        </div>
        <div class="card-body p-0">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Email</th>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pending in pendingUsers)
                    {
                        <tr>
                            <td>@pending.Email</td>
                            <td>@pending.FirstName</td>
                            <td>@pending.LastName</td>
                            <td>
                                <button class="btn btn-sm btn-success" @onclick="() => ApproveUser(pending.Id)"
                                        disabled="@_approvingUserId.Contains(pending.Id)">
                                    @if (_approvingUserId.Contains(pending.Id))
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                        <span>Approving...</span>
                                    }
                                    else
                                    {
                                        <span>Approve</span>
                                    }
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (users == null)
{
    <div class="text-center my-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2">Loading users...</p>
    </div>
}
else if (users.Count == 0)
{
    <div class="alert alert-info">No users found.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Email</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Roles</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in users)
            {
                <tr>
                    <td>@user.Email</td>
                    <td>@user.FirstName</td>
                    <td>@user.LastName</td>
                    <td>@string.Join(", ", user.Roles)</td>
                    <td>
                        <button class="btn btn-sm btn-warning" @onclick="() => ShowEditModal(user)">Edit</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => ConfirmDelete(user)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (showModal)
{
    <ModalDialog IsVisible="true" OnClose="CloseModal" Title="@(isEdit ? "Edit User" : "Create User")">
        <ChildContent>
            <AlertBanner Message="@errorMessage" />

            <div class="mb-3">
                <label class="form-label">Email</label>
                <input @bind="currentEmail" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">First Name</label>
                <input @bind="currentFirstName" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Last Name</label>
                <input @bind="currentLastName" class="form-control" />
            </div>

            @if (!isEdit)
            {
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input @bind="currentPassword" type="password" class="form-control" />
                </div>
            }

            <div class="mb-3">
                <label class="form-label">Roles</label>
                @if (roles != null)
                {
                    @foreach (var role in roles)
                    {
                        <div class="form-check" @key="@role.Id">
                            <input class="form-check-input" type="checkbox"
                                   id="role-@role.Id"
                                   checked="@selectedRoleIds.Contains(role.Id)"
                                   @onchange="(ChangeEventArgs e) => ToggleRole(role.Id, (bool)e.Value!)"/>
                            <label class="form-check-label" for="role-@role.Id">@role.Name</label>
                        </div>
                    }
                }
            </div>


        </ChildContent>
        <Footer>
            <button type="button" class="btn btn-secondary" @onclick="CloseModal">Close</button>
            <button type="button" class="btn btn-primary" @onclick="SaveUser">Save</button>
        </Footer>
    </ModalDialog>
    
}
@if (_showDeleteConfirm)
{
    <ModalDialog IsVisible="_showDeleteConfirm" OnClose="() => _showDeleteConfirm = false" Title="Delete User"
                 PanelClass="modal-panel--narrow">
        <ChildContent>

            <p style="font-family: var(--font-body); color: var(--text-muted);">
                Are you sure you want to delete <strong style="color: var(--text)">@_userIdToDelete?.Email</strong>? This action
                cannot be undone.
            </p>


        </ChildContent>
        <Footer>
            <button class="btn-secondary" @onclick="() => _showDeleteConfirm = false">Cancel</button>
            <button class="btn-danger" @onclick="DeleteUser" disabled="@_deleting">
                @(_deleting ? "Deleting..." : "Delete User")
            </button>
        </Footer>
    </ModalDialog>
}


@code {
    private List<UserDto>? users;
    private List<UserDto>? pendingUsers;
    private HashSet<string> _approvingUserId = new();
    private List<RoleDto>? roles;
    private bool showModal = false;
    private bool isEdit = false;
    private string? currentUserId;
    private string currentEmail = string.Empty;
    private string currentFirstName = string.Empty;
    private string currentLastName = string.Empty;
    private string currentPassword = string.Empty;
    private List<string> selectedRoleIds = new();
    private string? errorCode;
    private string? errorMessage;

    // Snapshot of values when the edit modal was opened
    private string _originalEmail = string.Empty;
    private string _originalFirstName = string.Empty;
    private string _originalLastName = string.Empty;
    private List<string> _originalRoleIds = new();
    private bool _showDeleteConfirm;
    private bool _deleting;
    private UserDto? _userIdToDelete;

    private bool HasChanges =>
        currentEmail != _originalEmail ||
        currentFirstName != _originalFirstName ||
        currentLastName != _originalLastName ||
        !selectedRoleIds.OrderBy(x => x).SequenceEqual(_originalRoleIds.OrderBy(x => x));

    protected override async Task OnAuthenticatedAsync()
    {
        await LoadUsers();
        await LoadPendingUsers();
        await LoadRoles();
    }

    private async Task LoadUsers()
    {
        try
        {
            users = await UserService.GetAllUsersAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load users: {ex.Message}";
            users = new List<UserDto>();
        }
    }

    private async Task LoadPendingUsers()
    {
        var result = await UserService.GetPendingUsersAsync();
        pendingUsers = result.IsSuccess ? result.Value : new List<UserDto>();
    }

    private async Task ApproveUser(string userId)
    {
        _approvingUserId.Add(userId);
        var result = await UserService.ApproveUserAsync(userId);
        _approvingUserId.Remove(userId);

        if (result.IsFailure)
        {
            errorCode = result.Error.Code.ToString();
            errorMessage = result.Error.Message;
        }
        else
        {
            await LoadPendingUsers();
            await LoadUsers();
        }
    }

    private async Task LoadRoles()
    {
        try
        {
            roles = await RoleService.GetAllRolesAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void ShowCreateModal()
    {
        isEdit = false;
        currentUserId = null;
        currentEmail = string.Empty;
        currentFirstName = string.Empty;
        currentLastName = string.Empty;
        currentPassword = string.Empty;
        selectedRoleIds.Clear();
        errorMessage = null;
        showModal = true;
    }

    private void ShowEditModal(UserDto user)
    {
        isEdit = true;
        currentUserId = user.Id;
        currentEmail = user.Email;
        currentFirstName = user.FirstName;
        currentLastName = user.LastName;
        selectedRoleIds = roles?.Where(r => user.Roles.Contains(r.Name)).Select(r => r.Id).ToList() ?? new();

        // Snapshot original values
        _originalEmail = currentEmail;
        _originalFirstName = currentFirstName;
        _originalLastName = currentLastName;
        _originalRoleIds = selectedRoleIds.ToList(); // copy, not reference

        errorMessage = null;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private void ToggleRole(string roleId, bool isChecked)
    {
        if (isChecked && !selectedRoleIds.Contains(roleId))
            selectedRoleIds.Add(roleId);
        else if (!isChecked && selectedRoleIds.Contains(roleId))
            selectedRoleIds.Remove(roleId);
    }

    private async Task SaveUser()
    {
        try
        {
            errorMessage = null;

            if (isEdit && !string.IsNullOrEmpty(currentUserId))
            {
                if (!HasChanges)
                {
                    CloseModal();
                    return;
                }

                var updateRequest = new UpdateUserRequest
                {
                    Email     = currentEmail,
                    FirstName = currentFirstName,
                    LastName  = currentLastName,
                    RoleIds   = selectedRoleIds
                };

                var result = await UserService.UpdateUserAsync(currentUserId, updateRequest);

                if (result.IsFailure)
                {
                    errorCode = result.Error.Code.ToString();
                    errorMessage = result.Error.Message;
                    return; // keep modal open
                }
            }
            else
            {
                var createRequest = new CreateUserRequest
                {
                    Email     = currentEmail,
                    FirstName = currentFirstName,
                    LastName  = currentLastName,
                    Password  = currentPassword,
                    RoleIds   = selectedRoleIds
                };

                await UserService.CreateUserAsync(createRequest);
            }

            await LoadUsers();
            CloseModal();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void ConfirmDelete(UserDto user)
    {
        _showDeleteConfirm = true;
        _userIdToDelete = user;
    }

    private async Task DeleteUser()
    {
        if (_userIdToDelete == null)
        {
            errorCode = "404";
            errorMessage = "No user selected for deletion.";
            return;
        }
        try
        {
            var result = await UserService.DeleteUserAsync(_userIdToDelete.Id);
            if (result.IsFailure)
            {
                errorCode = result.Error.Code.ToString();
                errorMessage = result.Error.Message;
                return;
            }
            _showDeleteConfirm = false;

            await LoadUsers();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}
