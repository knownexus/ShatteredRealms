@page "/analytics/event-attendances"
@using ShatteredRealms.Application.DTOs.Analytics
@using ShatteredRealms.Web.Components.Shared
@using ShatteredRealms.Web.Services
@inherits AuthPageBase
@inject AnalyticsClientService AnalyticsService
@rendermode InteractiveServer

<PageTitle>Event Attendances — Shattered Realms</PageTitle>

<div class="attendance-page">
    <PageHeader Title="Event Attendances" Subtitle="Who's going, sign-up times, and cancellations">
        <Actions>
            <div class="analytics-nav">
                <a href="/analytics" class="nav-pill">Event Log</a>
                <a href="/analytics/charts" class="nav-pill">Charts</a>
                <span class="nav-pill nav-pill--active">Event Attendances</span>
            </div>
        </Actions>
    </PageHeader>

    <AlertBanner Message="@_error" />

    <!-- Filter / search -->
    <div class="section-card filter-card">
        <div class="filter-inline">
            <div class="form-group">
                <label class="form-label">Search Events</label>
                <input class="form-control" placeholder="Event title..." @bind="_search" @oninput="OnSearchInput" />
            </div>
            <div class="filter-toggles">
                <label class="toggle-label">
                    <input type="checkbox" @bind="_showEmpty" /> Show events with no attendees
                </label>
                <label class="toggle-label">
                    <input type="checkbox" @bind="_showDeleted" /> Include deleted events
                </label>
                <label class="toggle-label">
                    <input type="checkbox" @bind="_upcomingOnly" @bind:after="OnUpcomingToggle" /> Upcoming only
                </label>
            </div>
        </div>
    </div>

    <LoadingSpinner IsVisible="_loading" Message="Loading attendance data..." />
    @if (_filtered.Count == 0)
    {
        <p class="no-data">No events match the current filters.</p>
    }
    else
    {
        <div class="event-count-bar">
            Showing @_filtered.Count event(s) · @_filtered.Sum(e => e.CurrentAttendees.Count) total attendees · @_filtered.Sum(e => e.Cancellations.Count) total cancellations
        </div>

        @foreach (var ev in _filtered)
        {
            var isExpanded = _expanded.Contains(ev.EventId);
            <div class="event-card @(ev.IsDeleted ? "event-card--deleted" : "")">
                <div class="event-card-header" @onclick="() => ToggleExpand(ev.EventId)">
                    <div class="event-card-info">
                        <span class="event-card-title">
                            @ev.Title
                            @if (ev.IsDeleted)
                            {
                                <span class="badge badge-deleted">Deleted</span>
                            }
                        </span>
                        <span class="event-card-date">@ev.StartsAt.ToString("ddd, MMM d yyyy")</span>
                    </div>
                    <div class="event-card-stats">
                        <span class="stat-pill stat-pill--going" title="Currently going">
                            @ev.CurrentAttendees.Count Going
                        </span>
                        @if (ev.Cancellations.Count > 0)
                        {
                            <span class="stat-pill stat-pill--cancelled" title="Cancelled (not re-registered)">
                                @ev.Cancellations.Count Cancelled
                            </span>
                        }
                        <span class="expand-chevron">@(isExpanded ? "▲" : "▼")</span>
                    </div>
                </div>

                @if (isExpanded)
                {
                    <div class="event-card-body">
                        <!-- Current Attendees -->
                        <div class="attendee-section">
                            <h3 class="attendee-section-title">
                                <span class="dot dot--green"></span> Currently Going (@ev.CurrentAttendees.Count)
                            </h3>
                            @if (ev.CurrentAttendees.Count == 0)
                            {
                                <p class="attendee-empty">No attendees yet.</p>
                            }
                            else
                            {
                                <table class="attendee-table">
                                    <thead>
                                        <tr>
                                            <th>User</th>
                                            <th>Email</th>
                                            <th>Signed Up</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var a in ev.CurrentAttendees)
                                        {
                                            <tr>
                                                <td>
                                                    <span class="attendee-name">@(string.IsNullOrEmpty(a.UserName) ? a.UserId : a.UserName)</span>
                                                </td>
                                                <td class="attendee-email">@a.UserEmail</td>
                                                <td class="attendee-time">@ToUk(a.RegisteredAt, "yyyy-MM-dd HH:mm")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </div>

                        <!-- Cancellations -->
                        @if (ev.Cancellations.Count > 0)
                        {
                            <div class="attendee-section attendee-section--cancel">
                                <h3 class="attendee-section-title">
                                    <span class="dot dot--red"></span> Cancelled (@ev.Cancellations.Count)
                                </h3>
                                <table class="attendee-table">
                                    <thead>
                                        <tr>
                                            <th>User</th>
                                            <th>Email</th>
                                            <th>Cancelled At</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var c in ev.Cancellations)
                                        {
                                            <tr class="row-cancelled">
                                                <td>
                                                    <span class="attendee-name">@(string.IsNullOrEmpty(c.UserName) ? c.UserId : c.UserName)</span>
                                                </td>
                                                <td class="attendee-email">@c.UserEmail</td>
                                                <td class="attendee-time cancelled-time">@ToUk(c.CancelledAt, "yyyy-MM-dd HH:mm")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
</div>


@code {
    private List<EventAttendanceOverviewDto> _all = [];
    private List<EventAttendanceOverviewDto> _filtered = [];
    private HashSet<int> _expanded = [];
    private bool _loading = true;
    private string? _error;

    private string _search = "";
    private bool _showEmpty = true;
    private bool _showDeleted;
    private bool _upcomingOnly;

    protected override string RequiredPermission => Domain.Shared.Claims.Permissions.Analytics.View;

    protected override async Task OnAuthenticatedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        _error   = null;
        var result = await AnalyticsService.GetEventAttendancesAsync();
        _loading = false;
        if (result.IsSuccess) { _all = result.Value; ApplyFilters(); }
        else _error = result.Error.Message;
    }

    private void ApplyFilters()
    {
        _filtered = _all
            .Where(e => !e.IsDeleted || _showDeleted)
            .Where(e => !_upcomingOnly || e.StartsAt >= DateTime.UtcNow)
            .Where(e => _showEmpty || e.CurrentAttendees.Count > 0 || e.Cancellations.Count > 0)
            .Where(e => string.IsNullOrEmpty(_search) || e.Title.Contains(_search, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        ApplyFilters();
        StateHasChanged();
    }

    private void OnUpcomingToggle()
    {
        ApplyFilters();
        StateHasChanged();
    }

    private void ToggleExpand(int eventId)
    {
        if (!_expanded.Add(eventId))
            _expanded.Remove(eventId);
        StateHasChanged();
    }

    private static readonly TimeZoneInfo UkTz = TimeZoneInfo.FindSystemTimeZoneById(
        OperatingSystem.IsWindows() ? "GMT Standard Time" : "Europe/London");

    private static string ToUk(DateTime utc, string fmt = "yyyy-MM-dd HH:mm")
    {
        var local = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), UkTz);
        return local.ToString(fmt) + (UkTz.IsDaylightSavingTime(local) ? " BST" : " GMT");
    }
}
