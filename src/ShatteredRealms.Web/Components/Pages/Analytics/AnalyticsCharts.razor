@page "/analytics/charts"
@using ShatteredRealms.Application.DTOs.Analytics
@using ShatteredRealms.Domain.Entities.Telemetry
@using ShatteredRealms.Web.Components.Shared
@using ShatteredRealms.Web.Services
@inherits AuthPageBase
@inject AnalyticsClientService AnalyticsService
@rendermode InteractiveServer

<PageTitle>Activity Charts — Shattered Realms</PageTitle>

<div class="charts-page">
    <PageHeader Title="Activity Charts" Subtitle="Activity over time with filters">
        <Actions>
            <div class="analytics-nav">
                <a href="/analytics" class="nav-pill">Event Log</a>
                <span class="nav-pill nav-pill--active">Charts</span>
                <a href="/analytics/event-attendances" class="nav-pill">Event Attendances</a>
            </div>
        </Actions>
    </PageHeader>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }

    <!-- Filter Bar -->
    <div class="section-card filter-card">
        <div class="filter-row">
            <div class="preset-group">
                @foreach (var p in _presets)
                {
                    <button class="preset-btn @(_activePreset == p.Label ? "preset-btn--active" : "")"
                            @onclick="() => ApplyPreset(p)">@p.Label</button>
                }
            </div>

            <div class="filter-inline">
                <div class="form-group">
                    <label class="form-label">From</label>
                    <input class="form-control" type="datetime-local" @bind="_from" @bind:after="ClearPreset" />
                </div>
                <div class="form-group">
                    <label class="form-label">To</label>
                    <input class="form-control" type="datetime-local" @bind="_to" @bind:after="ClearPreset" />
                </div>
                <div class="form-group">
                    <label class="form-label">Group By</label>
                    <select class="form-control" @bind="_groupBy">
                        <option value="day">Day</option>
                        <option value="week">Week</option>
                        <option value="month">Month</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Event Type</label>
                    <select class="form-control" @bind="_filterEventType">
                        <option value="">All types</option>
                        @foreach (var name in Enum.GetNames<TelemetryEventType>())
                        {
                            <option value="@name">@name</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">User</label>
                    <input class="form-control" placeholder="Username or email" @bind="_filterActorSearch" />
                </div>
                <button class="btn-gold" @onclick="LoadChart" disabled="@_loading">
                    @(_loading ? "Loading..." : "Apply")
                </button>
            </div>
        </div>
    </div>

    <LoadingSpinner IsVisible="_loading" Message="Loading chart data..." />
    @if (_chart is not null)
    {
        <!-- Activity Over Time -->
        <div class="section-card">
            <div class="chart-header">
                <h2 class="section-title">Activity Over Time</h2>
                <span class="chart-meta">@_chart.DataPoints.Sum(p => p.Count) total events · @_chart.DataPoints.Count(p => p.Count > 0) active @(_groupBy)s</span>
            </div>

            @if (_chart.DataPoints.Count == 0 || _chart.DataPoints.All(p => p.Count == 0))
            {
                <p class="no-data">No activity in the selected range.</p>
            }
            else
            {
                var maxCount  = _chart.DataPoints.Max(p => p.Count);
                const int barAreaH = 200; // px available for bars (label row is separate)

                <div class="bar-chart-container">
                    <div class="bar-chart-yaxis">
                        @for (int i = 4; i >= 0; i--)
                        {
                            <span class="yaxis-label">@((int)Math.Round(maxCount * i / 4.0))</span>
                        }
                    </div>
                    <div class="bar-chart-inner">
                        <div class="bars-and-grid" style="height:@(barAreaH)px;">
                            <div class="gridline" style="bottom:25%;"></div>
                            <div class="gridline" style="bottom:50%;"></div>
                            <div class="gridline" style="bottom:75%;"></div>
                            @foreach (var pt in _chart.DataPoints)
                            {
                                var barH    = maxCount > 0 ? (int)Math.Round(pt.Count * barAreaH / (double)maxCount) : 0;
                                var label   = _groupBy == "month" ? pt.Date.ToString("MMM yy") : pt.Date.ToString("MMM d");
                                var showLbl = ShouldShowLabel(pt.Date, _chart.DataPoints.Count);
                                <div class="bar-col" title="@pt.Date.ToString("yyyy-MM-dd"): @pt.Count event(s)">
                                    <div class="bar @(pt.Count == 0 ? "bar--zero" : "")" style="height:@(barH)px;"></div>
                                    @if (showLbl)
                                    {
                                        <span class="bar-label">@label</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Event Type Breakdown -->
        @if (_chart.Breakdown.Count > 0)
        {
            var maxBreak = _chart.Breakdown.Max(b => b.Count);
            <div class="section-card">
                <h2 class="section-title">Event Type Breakdown</h2>
                <div class="breakdown-list">
                    @foreach (var b in _chart.Breakdown)
                    {
                        var pct = maxBreak > 0 ? (int)Math.Round(b.Count * 100.0 / maxBreak) : 0;
                        <div class="breakdown-row">
                            <span class="breakdown-name">@b.EventTypeName</span>
                            <div class="breakdown-bar-track">
                                <div class="breakdown-bar" style="width: @pct%;"></div>
                            </div>
                            <span class="breakdown-count">@b.Count</span>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>


@code {
    private ActivityChartDto? _chart;
    private bool _loading;
    private string? _error;

    private DateTime _from = DateTime.Today;
    private DateTime _to   = DateTime.Now;
    private string _groupBy = "day";
    private string _filterEventType = "";
    private string _filterActorSearch = "";
    private string _activePreset = "Last 30 Days";

    private record Preset(string Label, int Days, string GroupBy);
    private readonly List<Preset> _presets =
    [
        new("Last 7 Days",  7,   "day"),
        new("Last 30 Days", 30,  "day"),
        new("Last 90 Days", 90,  "day"),
        new("Last Year",    365, "month"),
    ];

    protected override string RequiredPermission => Domain.Shared.Claims.Permissions.Analytics.View;

    protected override async Task OnAuthenticatedAsync()
    {
        await LoadChart();
    }

    private async Task ApplyPreset(Preset preset)
    {
        _activePreset = preset.Label;
        _from         = DateTime.Today.AddDays(-(preset.Days - 1));
        _to           = DateTime.Now;
        _groupBy      = preset.GroupBy;
        await LoadChart();
        StateHasChanged();
    }

    private async Task LoadChart()
    {
        _loading = true;
        _error   = null;

        TelemetryEventType? evType = null;
        if (!string.IsNullOrEmpty(_filterEventType) && Enum.TryParse<TelemetryEventType>(_filterEventType, out var parsed))
            evType = parsed;

        var result = await AnalyticsService.GetChartAsync(
            _from,
            _to,
            _groupBy,
            evType,
            string.IsNullOrEmpty(_filterActorSearch) ? null : _filterActorSearch);

        _loading = false;
        if (result.IsSuccess) _chart = result.Value;
        else _error = result.Error.Message;
    }

    private void ClearPreset() => _activePreset = "";

    private static bool ShouldShowLabel(DateTime date, int totalPoints)
    {
        if (totalPoints <= 14) return true;
        if (totalPoints <= 31) return date.Day % 7 == 1 || date.Day == 1;
        if (totalPoints <= 92) return date.Day == 1;
        return date.Month % 3 == 1 && date.Day == 1;
    }
}
