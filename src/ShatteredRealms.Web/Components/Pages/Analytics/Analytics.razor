@page "/analytics"
@using ShatteredRealms.Application.DTOs.Analytics
@using ShatteredRealms.Application.Features.Analytics.Queries
@using ShatteredRealms.Domain.Entities.Telemetry
@using ShatteredRealms.Web.Components.Shared
@using ShatteredRealms.Web.Services
@inherits AuthPageBase
@inject AnalyticsClientService AnalyticsService
@rendermode InteractiveServer

<PageTitle>Analytics — Shattered Realms</PageTitle>

<div class="analytics-page">
    <PageHeader Title="Analytics" Subtitle="Telemetry and activity tracking">
        <Actions>
            <div class="analytics-header-right">
                <div class="analytics-nav">
                    <span class="nav-pill nav-pill--active">Activity Log</span>
                    <a href="/analytics/charts" class="nav-pill">Charts</a>
                    <a href="/analytics/event-attendances" class="nav-pill">Event Attendances</a>
                </div>
                <button class="btn-gold-outline" @onclick="() => _showRulesPanel = !_showRulesPanel">
                    @(_showRulesPanel ? "Hide Flag Rules" : "Manage Flag Rules")
                </button>
            </div>
        </Actions>
    </PageHeader>

    <AlertBanner Message="@_error" />
    <!-- Summary Cards -->
    <LoadingSpinner IsVisible="_loadingSummary" Message="Loading summary..." />
    @if (_summary is not null)
    {
        <div class="summary-grid">
            <div class="stat-card">
                <span class="stat-value">@_summary.TotalActionsToday</span>
                <span class="stat-label">Actions Today</span>
            </div>
            <div class="stat-card">
                <span class="stat-value">@_summary.TotalActionsThisWeek</span>
                <span class="stat-label">Actions This Week</span>
            </div>
            <div class="stat-card">
                <span class="stat-value">@_summary.TotalActionsThisMonth</span>
                <span class="stat-label">Actions This Month</span>
            </div>
            <div class="stat-card">
                <span class="stat-value">@_summary.UniqueUsersThisWeek</span>
                <span class="stat-label">Unique Users (Week)</span>
            </div>
            <div class="stat-card">
                <span class="stat-value">@_summary.LoginsToday</span>
                <span class="stat-label">Logins Today</span>
            </div>
            <div class="stat-card">
                <span class="stat-value">@_summary.LoginsThisWeek</span>
                <span class="stat-label">Logins This Week</span>
            </div>
        </div>

        @if (_summary.TopActionTypes.Count > 0)
        {
            <div class="section-card">
                <h2 class="section-title">Top Action Types This Week</h2>
                <div class="top-actions-list">
                    @foreach (var at in _summary.TopActionTypes)
                    {
                        <div class="top-action-row">
                            <span class="top-action-name">@at.ActionType</span>
                            <span class="top-action-count">@at.Count</span>
                        </div>
                    }
                </div>
            </div>
        }
    }

    <!-- Flag Rules Panel -->
    @if (_showRulesPanel)
    {
        <div class="section-card rules-panel">
            <h2 class="section-title">Flag Rules</h2>
            <p class="rules-desc">Flag rules automatically highlight matching Actions in the log. Flagged rows appear with a red indicator.</p>

            <AlertBanner Message="@_rulesError" />

            <div class="new-rule-form">
                <h3 class="form-subtitle">Add New Rule</h3>
                <div class="rule-form-row">
                    <div class="form-group">
                        <label class="form-label">Rule Type</label>
                        <select class="form-control" @bind="_newRuleType">
                            <option value="@FlagRuleType.User">Flag by User</option>
                            <option value="@FlagRuleType.ActionType">Flag by Action Type</option>
                            <option value="@FlagRuleType.RoleAction">Flag by Role + Action</option>
                        </select>
                    </div>
                    @if (_newRuleType == FlagRuleType.User)
                    {
                        <div class="form-group">
                            <label class="form-label">User ID</label>
                            <input class="form-control" placeholder="User ID to flag" @bind="_newRuleUserId" />
                        </div>
                    }
                    @if (_newRuleType == FlagRuleType.ActionType || _newRuleType == FlagRuleType.RoleAction)
                    {
                        <div class="form-group">
                            <label class="form-label">Actions Type</label>
                            <select class="form-control" @bind="_newRuleActionTypeStr">
                                @if (_newRuleType == FlagRuleType.RoleAction)
                                {
                                    <option value="">Any</option>
                                }
                                @foreach (var name in Enum.GetNames<TelemetryActionType>())
                                {
                                    <option value="@name">@name</option>
                                }
                            </select>
                        </div>
                    }
                    @if (_newRuleType == FlagRuleType.RoleAction)
                    {
                        <div class="form-group">
                            <label class="form-label">User Role</label>
                            <input class="form-control" placeholder="e.g. Admin, User" @bind="_newRuleRole" />
                        </div>
                    }
                    <div class="form-group rule-reason">
                        <label class="form-label">Reason</label>
                        <input class="form-control" placeholder="Why this rule exists" @bind="_newRuleReason" />
                    </div>
                    <button class="btn-gold rule-add-btn" @onclick="AddRule" disabled="@_savingRule">
                        @(_savingRule ? "Adding..." : "Add Rule")
                    </button>
                </div>
            </div>

            <LoadingSpinner IsVisible="_loadingRules" Message="Loading rules..." />
            @if (_rules.Count == 0)
            {
                <p class="no-actions">No flag rules defined.</p>
            }
            else
            {
                <table class="actions-table rules-table">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Target</th>
                            <th>Reason</th>
                            <th>Created By</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rule in _rules)
                        {
                            <tr class="@(!rule.IsActive ? "rule-inactive" : "")">
                                <td><span class="badge badge-rule">@rule.RuleTypeName</span></td>
                                <td class="rule-target">
                                    @if (rule.RuleType == FlagRuleType.User)
                                    {
                                        <span>@(rule.TargetUserName ?? rule.TargetUserId)</span>
                                    }
                                    else if (rule.RuleType == FlagRuleType.ActionType)
                                    {
                                        <span>@rule.ActionTypeName</span>
                                    }
                                    else
                                    {
                                        <span>@rule.ActorRole@(rule.ActionType.HasValue ? $" → {rule.ActionTypeName}" : "")</span>
                                    }
                                </td>
                                <td>@rule.Reason</td>
                                <td>@rule.CreatedByName</td>
                                <td>
                                    @if (rule.IsActive)
                                    {
                                        <span class="badge badge-active">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-inactive">Disabled</span>
                                    }
                                </td>
                                <td class="rule-actions">
                                    <button class="btn-xs btn-secondary" @onclick="() => ToggleRule(rule)">
                                        @(rule.IsActive ? "Disable" : "Enable")
                                    </button>
                                    <button class="btn-xs btn-danger" @onclick="() => DeleteRule(rule.Id)">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }

    <!-- Action Log -->
    <div class="section-card">
        <div class="filter-bar">
            <h2 class="section-title">Action Log</h2>
            <div class="filter-controls">
                
                <select class="form-control filter-select" @bind="_filterActionType">
                    <option value="">All types</option>
                    @foreach (var name in Enum.GetNames<TelemetryActionType>())
                    {
                        <option value="@name">@name</option>
                    }
                </select>
                <input class="form-control filter-input" placeholder="Username or email" @bind="_filterActorSearch" />
                <input class="form-control filter-input" type="date" @bind="_filterFrom" />
                <input class="form-control filter-input" type="date" @bind="_filterTo" />
                <button class="btn-gold" @onclick="ApplyFilters">Filter</button>
                <button class="btn-secondary" @onclick="ClearFilters">Clear</button>
            </div>
        </div>

        <LoadingSpinner IsVisible="_loadingActions" Message="Loading Actions..." />
        @if (_actions.Count == 0)
        {
            <p class="no-actions">No actions found for the selected filters.</p>
        }
        else
        {
            <div class="actions-table-wrapper">
                <table class="actions-table">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Time</th>
                            <th>Action</th>
                            <th>User</th>
                            <th>Role</th>
                            <th>Target</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var act in _actions)
                        {
                            <tr class="action-row @(act.AnyFlagged ? "row-flagged" : "") @(act.IsFlagged ? "row-flagged-direct" : "")"
                                @onclick="() => OpenDetail(act)">
                                <td class="cell-flag">
                                    @if (act.IsFlagged)
                                    {
                                        <span class="flag-icon flag-direct" title="@($"Manually flagged: {act.FlagReason}")">⚑</span>
                                    }
                                    else if (act.IsRuleFlagged)
                                    {
                                        <span class="flag-icon flag-rule" title="@($"Rule flag: {act.MatchedRuleReason}")">⚑</span>
                                    }
                                </td>
                                <td class="cell-time">@ToUk(act.OccurredAt)</td>
                                <td class="cell-type">@act.ActionTypeName</td>
                                <td class="cell-actor">
                                    <span class="actor-name">@(string.IsNullOrEmpty(act.ActorName) ? act.ActorId : act.ActorName)</span>
                                    @if (!string.IsNullOrEmpty(act.ActorEmail) && act.ActorEmail != act.ActorName)
                                    {
                                        <span class="actor-email">@act.ActorEmail</span>
                                    }
                                </td>
                                <td class="cell-role">
                                    @if (!string.IsNullOrEmpty(act.ActorRole))
                                    {
                                        <span class="role-badge">@act.ActorRole</span>
                                    }
                                </td>
                                <td class="cell-target">@(act.TargetName ?? act.TargetId)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="pagination">
                <button class="btn-secondary" @onclick="PrevPage" disabled="@(_page <= 1)">‹ Prev</button>
                <span class="page-info">Page @_page of @TotalPages (@_totalCount total)</span>
                <button class="btn-secondary" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next ›</button>
                <input class="form-control-number" type="number" min="1" step="1" @bind="@PageSize"/>
                <button class="btn-gold" @onclick="ApplyFilters">Apply</button>


            </div>
        }
    </div>
</div>

<!-- Action Detail Modal -->
@if (_detailAction is not null)
{
    <ModalDialog IsVisible="_detailAction is not null" OnClose="CloseDetail" Title="Action Detail" PanelClass="detail-modal">
        <ChildContent>
            <div class="detail-header-inner">
                <h2>Action Detail</h2>
                @if (_detailAction.AnyFlagged)
                {
                    <span class="detail-flag-badge @(_detailAction.IsFlagged ? "badge-flagged-direct" : "badge-flagged-rule")">
                        ⚑ @(_detailAction.IsFlagged ? "Manually Flagged" : "Rule Flagged")
                    </span>
                }
            </div>
            <div class="modal-body detail-body">
                <div class="detail-grid">
                    <div class="detail-section">
                        <h3 class="detail-section-title">Action</h3>
                        <div class="detail-row">
                            <span class="detail-label">Type</span>
                            <span class="detail-value type-value">@_detailAction.ActionTypeName</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Time</span>
                            <span class="detail-value">@ToUk(_detailAction.OccurredAt)</span>
                        </div>
                        @if (!string.IsNullOrEmpty(_detailAction.TargetName) || !string.IsNullOrEmpty(_detailAction.TargetId))
                        {
                            <div class="detail-row">
                                <span class="detail-label">Target</span>
                                <span class="detail-value">
                                    @(_detailAction.TargetName ?? _detailAction.TargetId)
                                    @if (!string.IsNullOrEmpty(_detailAction.TargetId) && _detailAction.TargetId != _detailAction.TargetName)
                                    {
                                        <span class="detail-subtext"> (ID: @_detailAction.TargetId)</span>
                                    }
                                </span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(_detailAction.Details))
                        {
                            <div class="detail-row">
                                <span class="detail-label">Details</span>
                                <span class="detail-value">@_detailAction.Details</span>
                            </div>
                        }
                    </div>

                    <div class="detail-section">
                        <h3 class="detail-section-title">Who Did It</h3>
                        <div class="detail-row">
                            <span class="detail-label">Username</span>
                            <span class="detail-value actor-name-large">@(string.IsNullOrEmpty(_detailAction.ActorName) ? _detailAction.ActorId : _detailAction.ActorName)</span>
                        </div>
                        @if (!string.IsNullOrEmpty(_detailAction.ActorEmail))
                        {
                            <div class="detail-row">
                                <span class="detail-label">Email</span>
                                <span class="detail-value">@_detailAction.ActorEmail</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(_detailAction.ActorRole))
                        {
                            <div class="detail-row">
                                <span class="detail-label">Role</span>
                                <span class="detail-value"><span class="role-badge">@_detailAction.ActorRole</span></span>
                            </div>
                        }
                        <div class="detail-row">
                            <span class="detail-label">User ID</span>
                            <span class="detail-value detail-subtext">@_detailAction.ActorId</span>
                        </div>
                    </div>

                    @if (_detailAction.IsFlagged || _detailAction.IsRuleFlagged)
                    {
                        <div class="detail-section detail-flag-info">
                            <h3 class="detail-section-title">Flag Information</h3>
                            @if (_detailAction.IsFlagged)
                            {
                                <div class="detail-row">
                                    <span class="detail-label">Flagged At</span>
                                    <span class="detail-value">@ToUk(_detailAction.FlaggedAt)</span>
                                </div>
                                @if (!string.IsNullOrEmpty(_detailAction.FlagReason))
                                {
                                    <div class="detail-row">
                                        <span class="detail-label">Flag Reason</span>
                                        <span class="detail-value">@_detailAction.FlagReason</span>
                                    </div>
                                }
                            }
                            @if (_detailAction.IsRuleFlagged && !string.IsNullOrEmpty(_detailAction.MatchedRuleReason))
                            {
                                <div class="detail-row">
                                    <span class="detail-label">Rule Match</span>
                                    <span class="detail-value">@_detailAction.MatchedRuleReason</span>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Flag / Unflag section -->
                <div class="detail-flag-actions">
                    @if (_detailAction.IsFlagged)
                    {
                        <button class="btn-secondary" @onclick="UnflagCurrentAction" disabled="@_flagging">
                            @(_flagging ? "Removing flag..." : "Remove Flag")
                        </button>
                    }
                    else
                    {
                        <div class="flag-form">
                            <input class="form-control flag-reason-input" placeholder="Flag reason (optional)" @bind="_flagReason" />
                            <button class="btn-danger-outline" @onclick="FlagCurrentAction" disabled="@_flagging">
                                @(_flagging ? "Flagging..." : "⚑ Flag This Action")
                            </button>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(_detailError))
                {
                    <AlertBanner Message="@_detailError" />
                }

                <!-- Quick watch rule for this user -->
                @if (!string.IsNullOrEmpty(_detailAction.ActorId))
                {
                    <div class="detail-watch-section">
                        <div class="detail-watch-header">
                            <span class="detail-watch-title">Watch User</span>
                            <span class="detail-watch-actor">@(string.IsNullOrEmpty(_detailAction.ActorName) ? _detailAction.ActorId : _detailAction.ActorName)</span>
                        </div>
                        @if (!string.IsNullOrEmpty(_watchRuleSuccess))
                        {
                            <AlertBanner Message="@_watchRuleSuccess" Type="success" />
                        }
                        <div class="watch-form">
                            <input class="form-control flag-reason-input" placeholder="Watch reason (required)" @bind="_quickWatchReason" />
                            <button class="btn-warning" @onclick="QuickWatchActor" disabled="@(_quickWatching || string.IsNullOrWhiteSpace(_quickWatchReason))">
                                @(_quickWatching ? "Adding..." : "Add Watch Rule")
                            </button>
                        </div>
                    </div>
                }
            </div>
        </ChildContent>

    </ModalDialog>
}


@code {
    private AnalyticsSummaryDto? _summary;
    private List<TelemetryActionDto> _actions = [];
    private List<AnalyticsFlagRuleDto> _rules = [];
    private bool _loadingSummary = true;
    private bool _loadingActions = true;
    private bool _loadingRules;
    private bool _showRulesPanel;
    private string? _error;
    private string? _rulesError;

    private int _page = 1;

    private int PageSize
    {
        get;
        set => field = value < 1 ? 1 : value;
    } = 20;

    private int _totalCount;
    private int TotalPages => _totalCount == 0 ? 1 : (int)Math.Ceiling(_totalCount / (double)PageSize);

    // Filters
    private string _filterActionType = "";
    private string _filterActorSearch = "";
    private DateTime? _filterFrom;
    private DateTime? _filterTo;

    // Detail modal
    private TelemetryActionDto? _detailAction;
    private bool _flagging;
    private string _flagReason = "";
    private string? _detailError;
    private string _quickWatchReason = "";
    private bool _quickWatching;
    private string? _watchRuleSuccess;

    // New rule form
    private FlagRuleType _newRuleType = FlagRuleType.User;
    private string _newRuleUserId = "";
    private string _newRuleActionTypeStr = "";
    private string _newRuleRole = "";
    private string _newRuleReason = "";
    private bool _savingRule;

    protected override string RequiredPermission => Domain.Shared.Claims.Permissions.Analytics.View;

    protected override async Task OnAuthenticatedAsync()
    {
        await Task.WhenAll(LoadSummary(), LoadActions(), LoadRules());
    }

    private async Task LoadSummary()
    {
        _loadingSummary = true;
        var result = await AnalyticsService.GetSummaryAsync();
        _loadingSummary = false;
        if (result.IsSuccess) _summary = result.Value;
        else _error = result.Error.Message;
    }

    private async Task LoadActions()
    {
        _loadingActions = true;
        TelemetryActionType? actionType = null;
        if (!string.IsNullOrEmpty(_filterActionType) && Enum.TryParse<TelemetryActionType>(_filterActionType, out var parsed))
            actionType = parsed;

        var result = await AnalyticsService.GetActionsAsync(
            page: _page,
            pageSize: PageSize,
            actionType: actionType,
            actorSearch: string.IsNullOrEmpty(_filterActorSearch) ? null : _filterActorSearch,
            from: _filterFrom,
            to: _filterTo?.AddDays(1));

        _loadingActions = false;
        if (result.IsSuccess)
        {
            _actions = result.Value.Actions;
            _totalCount = result.Value.TotalCount;
        }
        else _error = result.Error.Message;
    }

    private async Task LoadRules()
    {
        _loadingRules = true;
        var result = await AnalyticsService.GetRulesAsync();
        _loadingRules = false;
        if (result.IsSuccess) _rules = result.Value;
        else _rulesError = result.Error.Message;
    }

    private async Task ApplyFilters()
    {
        _page = 1;
        await LoadActions();
        StateHasChanged();
    }

    private async Task ClearFilters()
    {
        _filterActionType = "";
        _filterActorSearch = "";
        _filterFrom = null;
        _filterTo = null;
        _page = 1;
        await LoadActions();
        StateHasChanged();
    }

    private async Task PrevPage()
    {
        if (_page > 1) { _page--; await LoadActions(); StateHasChanged(); }
    }

    private async Task NextPage()
    {
        if (_page < TotalPages) { _page++; await LoadActions(); StateHasChanged(); }
    }

    private void OpenDetail(TelemetryActionDto ev)
    {
        _detailAction       = ev;
        _flagReason        = "";
        _detailError       = null;
        _quickWatchReason  = "";
        _watchRuleSuccess  = null;
        StateHasChanged();
    }

    private void CloseDetail()
    {
        _detailAction = null;
        StateHasChanged();
    }

    private async Task FlagCurrentAction()
    {
        if (_detailAction is null) return;
        _flagging = true;
        _detailError = null;
        var result = await AnalyticsService.FlagActionAsync(_detailAction.Id, string.IsNullOrEmpty(_flagReason) ? null : _flagReason);
        _flagging = false;

        if (result.IsSuccess)
        {
            _detailAction.IsFlagged  = true;
            _detailAction.FlagReason = string.IsNullOrEmpty(_flagReason) ? null : _flagReason;
            _detailAction.FlaggedAt  = DateTime.UtcNow;
            var row = _actions.FirstOrDefault(e => e.Id == _detailAction.Id);
            if (row is not null) { row.IsFlagged = true; row.FlagReason = _detailAction.FlagReason; }
        }
        else _detailError = result.Error.Message;

        StateHasChanged();
    }

    private async Task UnflagCurrentAction()
    {
        if (_detailAction is null) return;
        _flagging = true;
        _detailError = null;
        var result = await AnalyticsService.UnflagActionAsync(_detailAction.Id);
        _flagging = false;

        if (result.IsSuccess)
        {
            _detailAction.IsFlagged  = false;
            _detailAction.FlagReason = null;
            _detailAction.FlaggedAt  = null;
            var row = _actions.FirstOrDefault(e => e.Id == _detailAction.Id);
            if (row is not null) { row.IsFlagged = false; row.FlagReason = null; }
        }
        else _detailError = result.Error.Message;

        StateHasChanged();
    }

    private async Task AddRule()
    {
        if (string.IsNullOrWhiteSpace(_newRuleReason)) return;
        _savingRule = true;
        _rulesError = null;

        TelemetryActionType? evType = null;
        if (!string.IsNullOrEmpty(_newRuleActionTypeStr) && Enum.TryParse<TelemetryActionType>(_newRuleActionTypeStr, out var et))
            evType = et;

        var result = await AnalyticsService.CreateRuleAsync(new CreateFlagRulePayload(
            _newRuleType,
            _newRuleType == FlagRuleType.User ? _newRuleUserId : null,
            (_newRuleType == FlagRuleType.ActionType || _newRuleType == FlagRuleType.RoleAction) ? evType : null,
            _newRuleType == FlagRuleType.RoleAction ? _newRuleRole : null,
            _newRuleReason));

        _savingRule = false;

        if (result.IsSuccess)
        {
            _rules.Insert(0, result.Value);
            _newRuleUserId = "";
            _newRuleActionTypeStr = "";
            _newRuleRole = "";
            _newRuleReason = "";
            await LoadActions();
        }
        else _rulesError = result.Error.Message;

        StateHasChanged();
    }

    private async Task ToggleRule(AnalyticsFlagRuleDto rule)
    {
        _rulesError = null;
        var result = await AnalyticsService.SetRuleActiveAsync(rule.Id, !rule.IsActive);
        if (result.IsSuccess)
        {
            rule.IsActive = !rule.IsActive;
            await LoadActions();
        }
        else _rulesError = result.Error.Message;
        StateHasChanged();
    }

    private async Task DeleteRule(int id)
    {
        _rulesError = null;
        var result = await AnalyticsService.DeleteRuleAsync(id);
        if (result.IsSuccess)
        {
            _rules.RemoveAll(r => r.Id == id);
            await LoadActions();
        }
        else _rulesError = result.Error.Message;
        StateHasChanged();
    }

    private async Task QuickWatchActor()
    {
        if (_detailAction is null || string.IsNullOrWhiteSpace(_quickWatchReason)) return;
        _quickWatching    = true;
        _watchRuleSuccess = null;

        var result = await AnalyticsService.CreateRuleAsync(new CreateFlagRulePayload(
            FlagRuleType.User,
            _detailAction.ActorId,
            null,
            null,
            _quickWatchReason));

        _quickWatching = false;

        if (result.IsSuccess)
        {
            _rules.Insert(0, result.Value);
            _quickWatchReason = "";
            _watchRuleSuccess = $"Watch rule created for {(string.IsNullOrEmpty(_detailAction.ActorName) ? _detailAction.ActorId : _detailAction.ActorName)}.";
            await LoadActions();
        }
        else _detailError = result.Error.Message;

        StateHasChanged();
    }

    private static readonly TimeZoneInfo UkTz = TimeZoneInfo.FindSystemTimeZoneById(
        OperatingSystem.IsWindows() ? "GMT Standard Time" : "Europe/London");

    private static string ToUk(DateTime utc, string fmt = "yyyy-MM-dd HH:mm:ss")
    {
        var local = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), UkTz);
        return local.ToString(fmt) + (UkTz.IsDaylightSavingTime(local) ? " BST" : " GMT");
    }

    private static string ToUk(DateTime? utc, string fmt = "yyyy-MM-dd HH:mm:ss") =>
        utc.HasValue ? ToUk(utc.Value, fmt) : "—";
}
