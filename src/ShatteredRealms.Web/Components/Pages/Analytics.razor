@page "/analytics"
@using ShatteredRealms.Application.DTOs.Analytics
@using ShatteredRealms.Application.Features.Analytics.Queries
@using ShatteredRealms.Domain.Entities.Telemetry
@using ShatteredRealms.Web.Services
@inject AnalyticsClientService AnalyticsService
@inject AuthService AuthService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Analytics — Shattered Realms</PageTitle>

<div class="analytics-page">
    <div class="analytics-header">
        <div>
            <h1 class="analytics-title">Analytics</h1>
            <p class="analytics-subtitle">Telemetry and activity tracking</p>
        </div>
        <button class="btn-gold-outline" @onclick="() => _showRulesPanel = !_showRulesPanel">
            @(_showRulesPanel ? "Hide Flag Rules" : "Manage Flag Rules")
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }

    <!-- Summary Cards -->
    @if (_loadingSummary)
    {
        <div class="analytics-loading"><div class="loading-orb"></div><span>Loading summary…</span></div>
    }
    else if (_summary is not null)
    {
        <div class="summary-grid">
            <div class="stat-card">
                <span class="stat-value">@_summary.TotalEventsToday</span>
                <span class="stat-label">Events Today</span>
            </div>
            <div class="stat-card">
                <span class="stat-value">@_summary.TotalEventsThisWeek</span>
                <span class="stat-label">Events This Week</span>
            </div>
            <div class="stat-card">
                <span class="stat-value">@_summary.TotalEventsThisMonth</span>
                <span class="stat-label">Events This Month</span>
            </div>
            <div class="stat-card">
                <span class="stat-value">@_summary.UniqueActorsThisWeek</span>
                <span class="stat-label">Unique Actors (Week)</span>
            </div>
            <div class="stat-card">
                <span class="stat-value">@_summary.LoginsToday</span>
                <span class="stat-label">Logins Today</span>
            </div>
            <div class="stat-card">
                <span class="stat-value">@_summary.LoginsThisWeek</span>
                <span class="stat-label">Logins This Week</span>
            </div>
        </div>

        @if (_summary.TopEventTypes.Count > 0)
        {
            <div class="section-card">
                <h2 class="section-title">Top Event Types This Week</h2>
                <div class="top-events-list">
                    @foreach (var et in _summary.TopEventTypes)
                    {
                        <div class="top-event-row">
                            <span class="top-event-name">@et.EventType</span>
                            <span class="top-event-count">@et.Count</span>
                        </div>
                    }
                </div>
            </div>
        }
    }

    <!-- Flag Rules Panel -->
    @if (_showRulesPanel)
    {
        <div class="section-card rules-panel">
            <h2 class="section-title">Flag Rules</h2>
            <p class="rules-desc">Flag rules automatically highlight matching events in the log. Flagged rows appear with a red indicator.</p>

            @if (!string.IsNullOrEmpty(_rulesError))
            {
                <div class="alert alert-danger">@_rulesError</div>
            }

            <div class="new-rule-form">
                <h3 class="form-subtitle">Add New Rule</h3>
                <div class="rule-form-row">
                    <div class="form-group">
                        <label class="form-label">Rule Type</label>
                        <select class="form-control" @bind="_newRuleType">
                            <option value="@FlagRuleType.User">Flag by User</option>
                            <option value="@FlagRuleType.EventType">Flag by Event Type</option>
                            <option value="@FlagRuleType.RoleAction">Flag by Role + Action</option>
                        </select>
                    </div>
                    @if (_newRuleType == FlagRuleType.User)
                    {
                        <div class="form-group">
                            <label class="form-label">User ID</label>
                            <input class="form-control" placeholder="User ID to flag" @bind="_newRuleUserId" />
                        </div>
                    }
                    @if (_newRuleType == FlagRuleType.EventType || _newRuleType == FlagRuleType.RoleAction)
                    {
                        <div class="form-group">
                            <label class="form-label">Event Type</label>
                            <select class="form-control" @bind="_newRuleEventTypeStr">
                                <option value="">Any</option>
                                @foreach (var name in Enum.GetNames<TelemetryEventType>())
                                {
                                    <option value="@name">@name</option>
                                }
                            </select>
                        </div>
                    }
                    @if (_newRuleType == FlagRuleType.RoleAction)
                    {
                        <div class="form-group">
                            <label class="form-label">Actor Role</label>
                            <input class="form-control" placeholder="e.g. Admin, User" @bind="_newRuleRole" />
                        </div>
                    }
                    <div class="form-group rule-reason">
                        <label class="form-label">Reason</label>
                        <input class="form-control" placeholder="Why this rule exists" @bind="_newRuleReason" />
                    </div>
                    <button class="btn-gold rule-add-btn" @onclick="AddRule" disabled="@_savingRule">
                        @(_savingRule ? "Adding…" : "Add Rule")
                    </button>
                </div>
            </div>

            @if (_loadingRules)
            {
                <div class="analytics-loading"><div class="loading-orb"></div><span>Loading rules…</span></div>
            }
            else if (_rules.Count == 0)
            {
                <p class="no-events">No flag rules defined.</p>
            }
            else
            {
                <table class="events-table rules-table">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Target</th>
                            <th>Reason</th>
                            <th>Created By</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rule in _rules)
                        {
                            <tr class="@(!rule.IsActive ? "rule-inactive" : "")">
                                <td><span class="badge badge-rule">@rule.RuleTypeName</span></td>
                                <td class="rule-target">
                                    @if (rule.RuleType == FlagRuleType.User)
                                    {
                                        <span>@(rule.TargetUserName ?? rule.TargetUserId)</span>
                                    }
                                    else if (rule.RuleType == FlagRuleType.EventType)
                                    {
                                        <span>@rule.EventTypeName</span>
                                    }
                                    else
                                    {
                                        <span>@rule.ActorRole@(rule.EventType.HasValue ? $" → {rule.EventTypeName}" : "")</span>
                                    }
                                </td>
                                <td>@rule.Reason</td>
                                <td>@rule.CreatedByName</td>
                                <td>
                                    @if (rule.IsActive)
                                    {
                                        <span class="badge badge-active">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-inactive">Disabled</span>
                                    }
                                </td>
                                <td class="rule-actions">
                                    <button class="btn-xs btn-secondary" @onclick="() => ToggleRule(rule)">
                                        @(rule.IsActive ? "Disable" : "Enable")
                                    </button>
                                    <button class="btn-xs btn-danger" @onclick="() => DeleteRule(rule.Id)">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }

    <!-- Event Log -->
    <div class="section-card">
        <div class="filter-bar">
            <h2 class="section-title">Event Log</h2>
            <div class="filter-controls">
                <select class="form-control filter-select" @bind="_filterEventType">
                    <option value="">All types</option>
                    @foreach (var name in Enum.GetNames<TelemetryEventType>())
                    {
                        <option value="@name">@name</option>
                    }
                </select>
                <input class="form-control filter-input" placeholder="Username or email" @bind="_filterActorSearch" />
                <input class="form-control filter-input" type="date" @bind="_filterFrom" />
                <input class="form-control filter-input" type="date" @bind="_filterTo" />
                <button class="btn-gold" @onclick="ApplyFilters">Filter</button>
                <button class="btn-secondary" @onclick="ClearFilters">Clear</button>
            </div>
        </div>

        @if (_loadingEvents)
        {
            <div class="analytics-loading"><div class="loading-orb"></div><span>Loading events…</span></div>
        }
        else if (_events.Count == 0)
        {
            <p class="no-events">No events found for the selected filters.</p>
        }
        else
        {
            <div class="events-table-wrapper">
                <table class="events-table">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Time</th>
                            <th>Event</th>
                            <th>User</th>
                            <th>Role</th>
                            <th>Target</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ev in _events)
                        {
                            <tr class="event-row @(ev.AnyFlagged ? "row-flagged" : "") @(ev.IsFlagged ? "row-flagged-direct" : "")"
                                @onclick="() => OpenDetail(ev)">
                                <td class="cell-flag">
                                    @if (ev.IsFlagged)
                                    {
                                        <span class="flag-icon flag-direct" title="@($"Manually flagged: {ev.FlagReason}")">⚑</span>
                                    }
                                    else if (ev.IsRuleFlagged)
                                    {
                                        <span class="flag-icon flag-rule" title="@($"Rule flag: {ev.MatchedRuleReason}")">⚑</span>
                                    }
                                </td>
                                <td class="cell-time">@ev.OccurredAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td class="cell-type">@ev.EventTypeName</td>
                                <td class="cell-actor">
                                    <span class="actor-name">@(string.IsNullOrEmpty(ev.ActorName) ? ev.ActorId : ev.ActorName)</span>
                                    @if (!string.IsNullOrEmpty(ev.ActorEmail) && ev.ActorEmail != ev.ActorName)
                                    {
                                        <span class="actor-email">@ev.ActorEmail</span>
                                    }
                                </td>
                                <td class="cell-role">
                                    @if (!string.IsNullOrEmpty(ev.ActorRole))
                                    {
                                        <span class="role-badge">@ev.ActorRole</span>
                                    }
                                </td>
                                <td class="cell-target">@(ev.TargetName ?? ev.TargetId)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="pagination">
                <button class="btn-secondary" @onclick="PrevPage" disabled="@(_page <= 1)">‹ Prev</button>
                <span class="page-info">Page @_page of @TotalPages (@_totalCount total)</span>
                <button class="btn-secondary" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next ›</button>
            </div>
        }
    </div>
</div>

<!-- Event Detail Modal -->
@if (_detailEvent is not null)
{
    <div class="modal-backdrop" @onmousedown="() => _backdropDown = true" @onclick="CloseDetailViaBackdrop">
        <div class="modal-panel detail-modal" @onmousedown:stopPropagation @onclick:stopPropagation>
            <div class="modal-header">
                <div class="detail-header-inner">
                    <h2>Event Detail</h2>
                    @if (_detailEvent.AnyFlagged)
                    {
                        <span class="detail-flag-badge @(_detailEvent.IsFlagged ? "badge-flagged-direct" : "badge-flagged-rule")">
                            ⚑ @(_detailEvent.IsFlagged ? "Manually Flagged" : "Rule Flagged")
                        </span>
                    }
                </div>
                <button class="modal-close" @onclick="CloseDetail">×</button>
            </div>
            <div class="modal-body detail-body">
                <div class="detail-grid">
                    <div class="detail-section">
                        <h3 class="detail-section-title">Action</h3>
                        <div class="detail-row">
                            <span class="detail-label">Type</span>
                            <span class="detail-value type-value">@_detailEvent.EventTypeName</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Time</span>
                            <span class="detail-value">@_detailEvent.OccurredAt.ToString("yyyy-MM-dd HH:mm:ss UTC")</span>
                        </div>
                        @if (!string.IsNullOrEmpty(_detailEvent.TargetName) || !string.IsNullOrEmpty(_detailEvent.TargetId))
                        {
                            <div class="detail-row">
                                <span class="detail-label">Target</span>
                                <span class="detail-value">
                                    @(_detailEvent.TargetName ?? _detailEvent.TargetId)
                                    @if (!string.IsNullOrEmpty(_detailEvent.TargetId) && _detailEvent.TargetId != _detailEvent.TargetName)
                                    {
                                        <span class="detail-subtext"> (ID: @_detailEvent.TargetId)</span>
                                    }
                                </span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(_detailEvent.Details))
                        {
                            <div class="detail-row">
                                <span class="detail-label">Details</span>
                                <span class="detail-value">@_detailEvent.Details</span>
                            </div>
                        }
                    </div>

                    <div class="detail-section">
                        <h3 class="detail-section-title">Who Did It</h3>
                        <div class="detail-row">
                            <span class="detail-label">Username</span>
                            <span class="detail-value actor-name-large">@(string.IsNullOrEmpty(_detailEvent.ActorName) ? _detailEvent.ActorId : _detailEvent.ActorName)</span>
                        </div>
                        @if (!string.IsNullOrEmpty(_detailEvent.ActorEmail))
                        {
                            <div class="detail-row">
                                <span class="detail-label">Email</span>
                                <span class="detail-value">@_detailEvent.ActorEmail</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(_detailEvent.ActorRole))
                        {
                            <div class="detail-row">
                                <span class="detail-label">Role</span>
                                <span class="detail-value"><span class="role-badge">@_detailEvent.ActorRole</span></span>
                            </div>
                        }
                        <div class="detail-row">
                            <span class="detail-label">User ID</span>
                            <span class="detail-value detail-subtext">@_detailEvent.ActorId</span>
                        </div>
                    </div>

                    @if (_detailEvent.IsFlagged || _detailEvent.IsRuleFlagged)
                    {
                        <div class="detail-section detail-flag-info">
                            <h3 class="detail-section-title">Flag Information</h3>
                            @if (_detailEvent.IsFlagged)
                            {
                                <div class="detail-row">
                                    <span class="detail-label">Flagged At</span>
                                    <span class="detail-value">@(_detailEvent.FlaggedAt?.ToString("yyyy-MM-dd HH:mm:ss UTC") ?? "—")</span>
                                </div>
                                @if (!string.IsNullOrEmpty(_detailEvent.FlagReason))
                                {
                                    <div class="detail-row">
                                        <span class="detail-label">Flag Reason</span>
                                        <span class="detail-value">@_detailEvent.FlagReason</span>
                                    </div>
                                }
                            }
                            @if (_detailEvent.IsRuleFlagged && !string.IsNullOrEmpty(_detailEvent.MatchedRuleReason))
                            {
                                <div class="detail-row">
                                    <span class="detail-label">Rule Match</span>
                                    <span class="detail-value">@_detailEvent.MatchedRuleReason</span>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Flag / Unflag section -->
                <div class="detail-flag-actions">
                    @if (_detailEvent.IsFlagged)
                    {
                        <button class="btn-secondary" @onclick="UnflagCurrentEvent" disabled="@_flagging">
                            @(_flagging ? "Removing flag…" : "Remove Flag")
                        </button>
                    }
                    else
                    {
                        <div class="flag-form">
                            <input class="form-control flag-reason-input" placeholder="Flag reason (optional)" @bind="_flagReason" />
                            <button class="btn-danger-outline" @onclick="FlagCurrentEvent" disabled="@_flagging">
                                @(_flagging ? "Flagging…" : "⚑ Flag This Event")
                            </button>
                        </div>
                    }
                    <button class="btn-xs btn-secondary flag-user-btn" @onclick="FlagUserFromDetail">
                        Flag All Events by This User
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(_detailError))
                {
                    <div class="alert alert-danger">@_detailError</div>
                }
            </div>
        </div>
    </div>
}

<style>
    .analytics-page { max-width: 1200px; margin: 0 auto; padding: 2rem 1rem 4rem; }

    .analytics-header { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem; }
    .analytics-title { font-family: var(--font-heading); font-size: 2rem; color: var(--gold); margin: 0 0 0.25rem; }
    .analytics-subtitle { font-family: var(--font-body); color: var(--text-muted); margin: 0; font-size: 0.95rem; }
    .btn-gold-outline {
        padding: 0.5rem 1.1rem; border: 1px solid var(--gold);
        background: transparent; color: var(--gold); border-radius: 6px;
        font-family: var(--font-heading); font-size: 0.8rem; font-weight: 700;
        letter-spacing: 0.05em; cursor: pointer; transition: background 0.15s, color 0.15s;
    }
    .btn-gold-outline:hover { background: var(--gold); color: #07090f; }

    .alert { padding: 0.75rem 1rem; border-radius: 6px; font-family: var(--font-body); font-size: 0.88rem; margin-bottom: 1rem; }
    .alert-danger { background: rgba(255,69,58,0.12); border: 1px solid rgba(255,69,58,0.3); color: #ff453a; }

    .analytics-loading { display: flex; align-items: center; gap: 1rem; justify-content: center; padding: 3rem; color: var(--text-muted); font-family: var(--font-body); }
    .loading-orb { width: 22px; height: 22px; border: 2px solid rgba(201,168,76,0.2); border-top-color: var(--gold); border-radius: 50%; animation: spin 0.8s linear infinite; }
    @@keyframes spin { to { transform: rotate(360deg); } }

    .summary-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
    .stat-card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 1.25rem 1rem; display: flex; flex-direction: column; align-items: center; gap: 0.4rem; }
    .stat-value { font-family: var(--font-heading); font-size: 2rem; color: var(--gold); line-height: 1; }
    .stat-label { font-family: var(--font-body); font-size: 0.75rem; color: var(--text-muted); text-align: center; }

    .section-card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 1.5rem; margin-bottom: 2rem; }
    .section-title { font-family: var(--font-heading); font-size: 1.1rem; color: var(--text); margin: 0 0 1rem; }

    .top-events-list { display: flex; flex-direction: column; gap: 0.4rem; }
    .top-event-row { display: flex; justify-content: space-between; align-items: center; padding: 0.4rem 0.75rem; background: rgba(255,255,255,0.03); border-radius: 6px; font-family: var(--font-body); font-size: 0.88rem; }
    .top-event-name { color: var(--text); }
    .top-event-count { color: var(--gold); font-weight: 600; }

    /* Rules Panel */
    .rules-panel { border-color: rgba(201,168,76,0.3); }
    .rules-desc { font-family: var(--font-body); font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.25rem; }
    .form-subtitle { font-family: var(--font-heading); font-size: 0.9rem; color: var(--text-muted); margin: 0 0 0.75rem; }
    .new-rule-form { background: rgba(255,255,255,0.02); border: 1px solid var(--border); border-radius: 8px; padding: 1rem; margin-bottom: 1.5rem; }
    .rule-form-row { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 0.75rem; }
    .rule-reason { flex: 1 1 200px; }
    .rule-add-btn { align-self: flex-end; padding: 0.45rem 1.1rem; }
    .rule-inactive td { opacity: 0.45; }
    .rule-target { color: var(--text); }
    .rule-actions { display: flex; gap: 0.4rem; white-space: nowrap; }
    .badge { display: inline-block; padding: 0.15rem 0.55rem; border-radius: 4px; font-family: var(--font-body); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.04em; }
    .badge-rule { background: rgba(201,168,76,0.12); color: var(--gold); border: 1px solid rgba(201,168,76,0.3); }
    .badge-active { background: rgba(52,199,89,0.12); color: #34c759; border: 1px solid rgba(52,199,89,0.3); }
    .badge-inactive { background: rgba(255,255,255,0.06); color: var(--text-muted); border: 1px solid var(--border); }
    .rules-table { margin-top: 0; }
    .btn-xs { padding: 0.25rem 0.6rem; font-size: 0.75rem; border-radius: 4px; cursor: pointer; }
    .btn-danger { padding: 0.45rem 1rem; background: rgba(255,69,58,0.15); border: 1px solid rgba(255,69,58,0.3); color: #ff453a; border-radius: 6px; font-family: var(--font-body); font-size: 0.82rem; cursor: pointer; }
    .btn-danger:hover { background: rgba(255,69,58,0.25); }
    .btn-danger-outline { padding: 0.45rem 1rem; border: 1px solid rgba(255,69,58,0.4); background: transparent; color: #ff453a; border-radius: 6px; font-family: var(--font-body); font-size: 0.82rem; cursor: pointer; }
    .btn-danger-outline:hover { background: rgba(255,69,58,0.1); }

    /* Filter Bar */
    .filter-bar { display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem; }
    .filter-controls { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem; }
    .filter-select { min-width: 160px; }
    .filter-input { min-width: 130px; }

    .form-control { background: rgba(255,255,255,0.04); border: 1px solid var(--border); color: var(--text); border-radius: 6px; padding: 0.45rem 0.7rem; font-family: var(--font-body); font-size: 0.85rem; }
    .form-control:focus { outline: none; border-color: rgba(201,168,76,0.5); }
    .form-group { display: flex; flex-direction: column; gap: 0.35rem; }
    .form-label { font-family: var(--font-body); font-size: 0.78rem; color: var(--text-muted); letter-spacing: 0.04em; }

    .btn-gold { padding: 0.45rem 1.1rem; background: linear-gradient(135deg, #c9a84c, #a8883c); color: #07090f; border: none; border-radius: 6px; font-family: var(--font-heading); font-size: 0.82rem; font-weight: 700; letter-spacing: 0.06em; cursor: pointer; }
    .btn-gold:disabled { opacity: 0.45; cursor: not-allowed; }
    .btn-secondary { padding: 0.45rem 1rem; background: rgba(255,255,255,0.06); border: 1px solid var(--border); color: var(--text-muted); border-radius: 6px; font-family: var(--font-body); font-size: 0.85rem; cursor: pointer; }
    .btn-secondary:disabled { opacity: 0.4; cursor: not-allowed; }

    /* Event Table */
    .no-events { font-family: var(--font-body); color: var(--text-muted); text-align: center; padding: 2rem; }
    .events-table-wrapper { overflow-x: auto; }
    .events-table { width: 100%; border-collapse: collapse; font-family: var(--font-body); font-size: 0.85rem; }
    .events-table th { text-align: left; padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--border); color: var(--text-muted); font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; }
    .events-table td { padding: 0.55rem 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.04); color: var(--text); vertical-align: middle; }
    .event-row { cursor: pointer; transition: background 0.1s; }
    .event-row:hover td { background: rgba(255,255,255,0.04); }
    .row-flagged td { background: rgba(255,69,58,0.06) !important; }
    .row-flagged:hover td { background: rgba(255,69,58,0.1) !important; }
    .row-flagged-direct td { background: rgba(255,69,58,0.1) !important; }
    .row-flagged-direct:hover td { background: rgba(255,69,58,0.15) !important; }
    .cell-flag { width: 24px; text-align: center; }
    .flag-icon { font-size: 0.9rem; cursor: default; }
    .flag-direct { color: #ff453a; }
    .flag-rule { color: #ff9f0a; }
    .cell-time { color: var(--text-muted); white-space: nowrap; font-size: 0.8rem; }
    .cell-type { color: var(--gold); }
    .cell-actor { max-width: 160px; }
    .actor-name { display: block; color: var(--text); }
    .actor-email { display: block; font-size: 0.75rem; color: var(--text-muted); }
    .role-badge { display: inline-block; padding: 0.1rem 0.45rem; background: rgba(201,168,76,0.1); border: 1px solid rgba(201,168,76,0.25); color: var(--gold); border-radius: 4px; font-size: 0.72rem; }

    .pagination { display: flex; align-items: center; justify-content: center; gap: 1rem; margin-top: 1.25rem; font-family: var(--font-body); font-size: 0.85rem; }
    .page-info { color: var(--text-muted); }

    /* Modal */
    .modal-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,0.65); display: flex; align-items: center; justify-content: center; z-index: 1000; }
    .modal-panel { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; width: min(680px, 96vw); max-height: 90vh; overflow-y: auto; }
    .detail-modal { border-color: rgba(201,168,76,0.25); }
    .modal-header { display: flex; align-items: center; justify-content: space-between; padding: 1.25rem 1.75rem; border-bottom: 1px solid var(--border); }
    .modal-header h2 { font-family: var(--font-heading); font-size: 1.1rem; color: var(--text); margin: 0; }
    .modal-close { background: none; border: none; color: var(--text-muted); font-size: 1.4rem; cursor: pointer; padding: 0; }
    .modal-body { padding: 1.5rem 1.75rem; }

    .detail-header-inner { display: flex; align-items: center; gap: 0.75rem; }
    .detail-flag-badge { display: inline-block; padding: 0.2rem 0.65rem; border-radius: 4px; font-family: var(--font-body); font-size: 0.75rem; font-weight: 600; }
    .badge-flagged-direct { background: rgba(255,69,58,0.15); border: 1px solid rgba(255,69,58,0.35); color: #ff453a; }
    .badge-flagged-rule { background: rgba(255,159,10,0.12); border: 1px solid rgba(255,159,10,0.3); color: #ff9f0a; }

    .detail-body { display: flex; flex-direction: column; gap: 1.25rem; }
    .detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
    @@media (max-width: 560px) { .detail-grid { grid-template-columns: 1fr; } }
    .detail-section { background: rgba(255,255,255,0.02); border: 1px solid var(--border); border-radius: 8px; padding: 1rem; }
    .detail-flag-info { grid-column: 1 / -1; border-color: rgba(255,69,58,0.25); background: rgba(255,69,58,0.04); }
    .detail-section-title { font-family: var(--font-heading); font-size: 0.8rem; color: var(--gold); letter-spacing: 0.06em; text-transform: uppercase; margin: 0 0 0.75rem; }
    .detail-row { display: flex; gap: 0.75rem; margin-bottom: 0.5rem; align-items: flex-start; }
    .detail-label { font-family: var(--font-body); font-size: 0.78rem; color: var(--text-muted); min-width: 70px; padding-top: 0.05rem; }
    .detail-value { font-family: var(--font-body); font-size: 0.88rem; color: var(--text); flex: 1; word-break: break-word; }
    .type-value { color: var(--gold); font-weight: 600; }
    .actor-name-large { font-weight: 600; }
    .detail-subtext { color: var(--text-muted); font-size: 0.78rem; }

    .detail-flag-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 0.75rem; padding-top: 0.5rem; border-top: 1px solid var(--border); }
    .flag-form { display: flex; gap: 0.5rem; align-items: center; flex: 1; }
    .flag-reason-input { flex: 1; min-width: 150px; }
    .flag-user-btn { margin-left: auto; }
</style>

@code {
    private AnalyticsSummaryDto? _summary;
    private List<TelemetryEventDto> _events = [];
    private List<AnalyticsFlagRuleDto> _rules = [];
    private bool _loadingSummary = true;
    private bool _loadingEvents = true;
    private bool _loadingRules;
    private bool _showRulesPanel;
    private string? _error;
    private string? _rulesError;

    private int _page = 1;
    private const int PageSize = 50;
    private int _totalCount;
    private int TotalPages => _totalCount == 0 ? 1 : (int)Math.Ceiling(_totalCount / (double)PageSize);

    // Filters
    private string _filterEventType = "";
    private string _filterActorSearch = "";
    private DateTime? _filterFrom;
    private DateTime? _filterTo;

    // Detail modal
    private TelemetryEventDto? _detailEvent;
    private bool _backdropDown;
    private bool _flagging;
    private string _flagReason = "";
    private string? _detailError;

    // New rule form
    private FlagRuleType _newRuleType = FlagRuleType.User;
    private string _newRuleUserId = "";
    private string _newRuleEventTypeStr = "";
    private string _newRuleRole = "";
    private string _newRuleReason = "";
    private bool _savingRule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        if (!await AuthService.IsAuthenticatedAsync())
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (!await AuthService.HasPermissionAsync(Domain.Shared.Claims.Permissions.Analytics.View))
        {
            Navigation.NavigateTo("/");
            return;
        }

        await Task.WhenAll(LoadSummary(), LoadEvents(), LoadRules());
        StateHasChanged();
    }

    private async Task LoadSummary()
    {
        _loadingSummary = true;
        var result = await AnalyticsService.GetSummaryAsync();
        _loadingSummary = false;
        if (result.IsSuccess) _summary = result.Value;
        else _error = result.Error.Message;
    }

    private async Task LoadEvents()
    {
        _loadingEvents = true;
        TelemetryEventType? eventType = null;
        if (!string.IsNullOrEmpty(_filterEventType) && Enum.TryParse<TelemetryEventType>(_filterEventType, out var parsed))
            eventType = parsed;

        var result = await AnalyticsService.GetEventsAsync(
            page: _page,
            pageSize: PageSize,
            eventType: eventType,
            actorSearch: string.IsNullOrEmpty(_filterActorSearch) ? null : _filterActorSearch,
            from: _filterFrom,
            to: _filterTo.HasValue ? _filterTo.Value.AddDays(1) : null);

        _loadingEvents = false;
        if (result.IsSuccess)
        {
            _events = result.Value.Events;
            _totalCount = result.Value.TotalCount;
        }
        else _error = result.Error.Message;
    }

    private async Task LoadRules()
    {
        _loadingRules = true;
        var result = await AnalyticsService.GetRulesAsync();
        _loadingRules = false;
        if (result.IsSuccess) _rules = result.Value;
        else _rulesError = result.Error.Message;
    }

    private async Task ApplyFilters()
    {
        _page = 1;
        await LoadEvents();
        StateHasChanged();
    }

    private async Task ClearFilters()
    {
        _filterEventType = "";
        _filterActorSearch = "";
        _filterFrom = null;
        _filterTo = null;
        _page = 1;
        await LoadEvents();
        StateHasChanged();
    }

    private async Task PrevPage()
    {
        if (_page > 1) { _page--; await LoadEvents(); StateHasChanged(); }
    }

    private async Task NextPage()
    {
        if (_page < TotalPages) { _page++; await LoadEvents(); StateHasChanged(); }
    }

    private void OpenDetail(TelemetryEventDto ev)
    {
        _detailEvent = ev;
        _flagReason  = "";
        _detailError = null;
        StateHasChanged();
    }

    private void CloseDetail()
    {
        _detailEvent = null;
        StateHasChanged();
    }

    private void CloseDetailViaBackdrop()
    {
        if (_backdropDown) CloseDetail();
        _backdropDown = false;
    }

    private async Task FlagCurrentEvent()
    {
        if (_detailEvent is null) return;
        _flagging = true;
        _detailError = null;
        var result = await AnalyticsService.FlagEventAsync(_detailEvent.Id, string.IsNullOrEmpty(_flagReason) ? null : _flagReason);
        _flagging = false;

        if (result.IsSuccess)
        {
            _detailEvent.IsFlagged  = true;
            _detailEvent.FlagReason = string.IsNullOrEmpty(_flagReason) ? null : _flagReason;
            _detailEvent.FlaggedAt  = DateTime.UtcNow;
            var row = _events.FirstOrDefault(e => e.Id == _detailEvent.Id);
            if (row is not null) { row.IsFlagged = true; row.FlagReason = _detailEvent.FlagReason; }
        }
        else _detailError = result.Error.Message;

        StateHasChanged();
    }

    private async Task UnflagCurrentEvent()
    {
        if (_detailEvent is null) return;
        _flagging = true;
        _detailError = null;
        var result = await AnalyticsService.UnflagEventAsync(_detailEvent.Id);
        _flagging = false;

        if (result.IsSuccess)
        {
            _detailEvent.IsFlagged  = false;
            _detailEvent.FlagReason = null;
            _detailEvent.FlaggedAt  = null;
            var row = _events.FirstOrDefault(e => e.Id == _detailEvent.Id);
            if (row is not null) { row.IsFlagged = false; row.FlagReason = null; }
        }
        else _detailError = result.Error.Message;

        StateHasChanged();
    }

    private async Task FlagUserFromDetail()
    {
        if (_detailEvent is null) return;
        _detailError = null;
        var reason = $"User flagged from analytics detail view";
        var result = await AnalyticsService.CreateRuleAsync(new CreateFlagRulePayload(
            FlagRuleType.User, _detailEvent.ActorId, null, null, reason));

        if (result.IsSuccess)
        {
            _rules.Insert(0, result.Value);
            await LoadEvents();
        }
        else _detailError = result.Error.Message;

        StateHasChanged();
    }

    private async Task AddRule()
    {
        if (string.IsNullOrWhiteSpace(_newRuleReason)) return;
        _savingRule = true;
        _rulesError = null;

        TelemetryEventType? evType = null;
        if (!string.IsNullOrEmpty(_newRuleEventTypeStr) && Enum.TryParse<TelemetryEventType>(_newRuleEventTypeStr, out var et))
            evType = et;

        var result = await AnalyticsService.CreateRuleAsync(new CreateFlagRulePayload(
            _newRuleType,
            _newRuleType == FlagRuleType.User ? _newRuleUserId : null,
            (_newRuleType == FlagRuleType.EventType || _newRuleType == FlagRuleType.RoleAction) ? evType : null,
            _newRuleType == FlagRuleType.RoleAction ? _newRuleRole : null,
            _newRuleReason));

        _savingRule = false;

        if (result.IsSuccess)
        {
            _rules.Insert(0, result.Value);
            _newRuleUserId = "";
            _newRuleEventTypeStr = "";
            _newRuleRole = "";
            _newRuleReason = "";
            await LoadEvents();
        }
        else _rulesError = result.Error.Message;

        StateHasChanged();
    }

    private async Task ToggleRule(AnalyticsFlagRuleDto rule)
    {
        _rulesError = null;
        var result = await AnalyticsService.SetRuleActiveAsync(rule.Id, !rule.IsActive);
        if (result.IsSuccess)
        {
            rule.IsActive = !rule.IsActive;
            await LoadEvents();
        }
        else _rulesError = result.Error.Message;
        StateHasChanged();
    }

    private async Task DeleteRule(int id)
    {
        _rulesError = null;
        var result = await AnalyticsService.DeleteRuleAsync(id);
        if (result.IsSuccess)
        {
            _rules.RemoveAll(r => r.Id == id);
            await LoadEvents();
        }
        else _rulesError = result.Error.Message;
        StateHasChanged();
    }
}
