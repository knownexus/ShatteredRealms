@page "/analytics/charts"
@using ShatteredRealms.Application.DTOs.Analytics
@using ShatteredRealms.Domain.Entities.Telemetry
@using ShatteredRealms.Web.Services
@inject AnalyticsClientService AnalyticsService
@inject AuthService AuthService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Activity Charts — Shattered Realms</PageTitle>

<div class="charts-page">
    <div class="charts-header">
        <div>
            <h1 class="charts-title">Activity Charts</h1>
            <p class="charts-subtitle">Activity over time with filters</p>
        </div>
        <div class="analytics-nav">
            <a href="/analytics" class="nav-pill">Event Log</a>
            <span class="nav-pill nav-pill--active">Charts</span>
            <a href="/analytics/event-attendances" class="nav-pill">Event Attendances</a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }

    <!-- Filter Bar -->
    <div class="section-card filter-card">
        <div class="filter-row">
            <div class="preset-group">
                @foreach (var p in _presets)
                {
                    <button class="preset-btn @(_activePreset == p.Label ? "preset-btn--active" : "")"
                            @onclick="() => ApplyPreset(p)">@p.Label</button>
                }
            </div>

            <div class="filter-inline">
                <div class="form-group">
                    <label class="form-label">From</label>
                    <input class="form-control" type="date" @bind="_from" />
                </div>
                <div class="form-group">
                    <label class="form-label">To</label>
                    <input class="form-control" type="date" @bind="_to" />
                </div>
                <div class="form-group">
                    <label class="form-label">Group By</label>
                    <select class="form-control" @bind="_groupBy">
                        <option value="day">Day</option>
                        <option value="week">Week</option>
                        <option value="month">Month</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Event Type</label>
                    <select class="form-control" @bind="_filterEventType">
                        <option value="">All types</option>
                        @foreach (var name in Enum.GetNames<TelemetryEventType>())
                        {
                            <option value="@name">@name</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Actor</label>
                    <input class="form-control" placeholder="Username or email" @bind="_filterActorSearch" />
                </div>
                <button class="btn-gold" @onclick="LoadChart" disabled="@_loading">
                    @(_loading ? "Loading…" : "Apply")
                </button>
            </div>
        </div>
    </div>

    @if (_loading)
    {
        <div class="charts-loading"><div class="loading-orb"></div><span>Loading chart data…</span></div>
    }
    else if (_chart is not null)
    {
        <!-- Activity Over Time -->
        <div class="section-card">
            <div class="chart-header">
                <h2 class="section-title">Activity Over Time</h2>
                <span class="chart-meta">@_chart.DataPoints.Sum(p => p.Count) total events · @_chart.DataPoints.Count(p => p.Count > 0) active @(_groupBy)s</span>
            </div>

            @if (_chart.DataPoints.Count == 0 || _chart.DataPoints.All(p => p.Count == 0))
            {
                <p class="no-data">No activity in the selected range.</p>
            }
            else
            {
                var maxCount = _chart.DataPoints.Max(p => p.Count);
                var chartH   = 220;

                <div class="bar-chart-container">
                    <div class="bar-chart-yaxis">
                        @for (int i = 4; i >= 0; i--)
                        {
                            var val = (int)Math.Round(maxCount * i / 4.0);
                            <span class="yaxis-label">@val</span>
                        }
                    </div>
                    <div class="bar-chart-inner">
                        <div class="gridlines">
                            @for (int i = 1; i <= 4; i++)
                            {
                                var top = (int)Math.Round(chartH * i / 4.0);
                                <div class="gridline" style="bottom: @(chartH - top)px;"></div>
                            }
                        </div>
                        <div class="bars-row" style="height: @(chartH)px;">
                            @foreach (var pt in _chart.DataPoints)
                            {
                                var barH    = maxCount > 0 ? (int)Math.Round(pt.Count * chartH / (double)maxCount) : 0;
                                var label   = _groupBy == "month" ? pt.Date.ToString("MMM yy")
                                            : _groupBy == "week"  ? pt.Date.ToString("MMM d")
                                                                   : pt.Date.ToString("MMM d");
                                var showLbl = ShouldShowLabel(pt.Date, _chart.DataPoints.Count);
                                <div class="bar-col" title="@pt.Date.ToString("yyyy-MM-dd"): @pt.Count event(s)">
                                    <div class="bar @(pt.Count == 0 ? "bar--zero" : "")" style="height: @barH px;"></div>
                                    @if (showLbl)
                                    {
                                        <span class="bar-label">@label</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Event Type Breakdown -->
        @if (_chart.Breakdown.Count > 0)
        {
            var maxBreak = _chart.Breakdown.Max(b => b.Count);
            <div class="section-card">
                <h2 class="section-title">Event Type Breakdown</h2>
                <div class="breakdown-list">
                    @foreach (var b in _chart.Breakdown)
                    {
                        var pct = maxBreak > 0 ? (int)Math.Round(b.Count * 100.0 / maxBreak) : 0;
                        <div class="breakdown-row">
                            <span class="breakdown-name">@b.EventTypeName</span>
                            <div class="breakdown-bar-track">
                                <div class="breakdown-bar" style="width: @pct%;"></div>
                            </div>
                            <span class="breakdown-count">@b.Count</span>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

<style>
    .charts-page { max-width: 1200px; margin: 0 auto; padding: 2rem 1rem 4rem; }

    .charts-header { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem; }
    .charts-title { font-family: var(--font-heading); font-size: 2rem; color: var(--gold); margin: 0 0 0.25rem; }
    .charts-subtitle { font-family: var(--font-body); color: var(--text-muted); margin: 0; font-size: 0.95rem; }

    .analytics-nav { display: flex; gap: 0.4rem; flex-wrap: wrap; }
    .nav-pill { display: inline-block; padding: 0.35rem 0.85rem; border-radius: 20px; font-family: var(--font-body); font-size: 0.8rem; text-decoration: none; border: 1px solid var(--border); color: var(--text-muted); background: transparent; transition: border-color 0.15s, color 0.15s; }
    .nav-pill:hover { border-color: rgba(201,168,76,0.4); color: var(--gold); }
    .nav-pill--active { border-color: var(--gold); color: var(--gold); background: rgba(201,168,76,0.08); }

    .alert { padding: 0.75rem 1rem; border-radius: 6px; font-family: var(--font-body); font-size: 0.88rem; margin-bottom: 1rem; }
    .alert-danger { background: rgba(255,69,58,0.12); border: 1px solid rgba(255,69,58,0.3); color: #ff453a; }

    .section-card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 1.5rem; margin-bottom: 2rem; }
    .section-title { font-family: var(--font-heading); font-size: 1.1rem; color: var(--text); margin: 0 0 1.25rem; }

    .filter-card { padding: 1.25rem 1.5rem; }
    .filter-row { display: flex; flex-direction: column; gap: 1rem; }
    .preset-group { display: flex; gap: 0.4rem; flex-wrap: wrap; }
    .preset-btn { padding: 0.3rem 0.8rem; border-radius: 20px; border: 1px solid var(--border); background: transparent; color: var(--text-muted); font-family: var(--font-body); font-size: 0.78rem; cursor: pointer; transition: all 0.15s; }
    .preset-btn:hover { border-color: rgba(201,168,76,0.4); color: var(--gold); }
    .preset-btn--active { border-color: var(--gold); color: var(--gold); background: rgba(201,168,76,0.08); }
    .filter-inline { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 0.75rem; }
    .form-group { display: flex; flex-direction: column; gap: 0.3rem; }
    .form-label { font-family: var(--font-body); font-size: 0.75rem; color: var(--text-muted); letter-spacing: 0.04em; }
    .form-control { background: rgba(255,255,255,0.04); border: 1px solid var(--border); color: var(--text); border-radius: 6px; padding: 0.42rem 0.65rem; font-family: var(--font-body); font-size: 0.82rem; }
    .form-control:focus { outline: none; border-color: rgba(201,168,76,0.5); }
    .btn-gold { padding: 0.45rem 1.1rem; background: linear-gradient(135deg,#c9a84c,#a8883c); color: #07090f; border: none; border-radius: 6px; font-family: var(--font-heading); font-size: 0.82rem; font-weight: 700; letter-spacing: 0.06em; cursor: pointer; align-self: flex-end; }
    .btn-gold:disabled { opacity: 0.45; cursor: not-allowed; }

    .charts-loading { display: flex; align-items: center; gap: 1rem; justify-content: center; padding: 4rem; color: var(--text-muted); font-family: var(--font-body); }
    .loading-orb { width: 22px; height: 22px; border: 2px solid rgba(201,168,76,0.2); border-top-color: var(--gold); border-radius: 50%; animation: spin 0.8s linear infinite; }
    @@keyframes spin { to { transform: rotate(360deg); } }

    .chart-header { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 0.5rem; }
    .chart-meta { font-family: var(--font-body); font-size: 0.8rem; color: var(--text-muted); }

    .no-data { font-family: var(--font-body); color: var(--text-muted); text-align: center; padding: 2rem; }

    /* Bar Chart */
    .bar-chart-container { display: flex; gap: 0.5rem; overflow: hidden; }
    .bar-chart-yaxis { display: flex; flex-direction: column; justify-content: space-between; padding-bottom: 20px; min-width: 32px; text-align: right; }
    .yaxis-label { font-family: var(--font-body); font-size: 0.7rem; color: var(--text-muted); line-height: 1; }
    .bar-chart-inner { flex: 1; position: relative; overflow-x: auto; }
    .gridlines { position: absolute; inset: 0 0 20px 0; pointer-events: none; }
    .gridline { position: absolute; left: 0; right: 0; height: 1px; background: rgba(255,255,255,0.06); }
    .bars-row { display: flex; align-items: flex-end; gap: 2px; padding-bottom: 20px; min-width: min-content; }
    .bar-col { flex: 1; min-width: 6px; max-width: 32px; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; position: relative; cursor: default; }
    .bar { width: 100%; background: var(--gold); border-radius: 2px 2px 0 0; transition: opacity 0.15s; min-height: 1px; }
    .bar:hover { opacity: 0.75; }
    .bar--zero { background: rgba(201,168,76,0.15); min-height: 2px; }
    .bar-label { position: absolute; bottom: 0; font-family: var(--font-body); font-size: 0.62rem; color: var(--text-muted); white-space: nowrap; transform: translateX(-50%) translateY(100%); left: 50%; padding-top: 2px; }

    /* Breakdown */
    .breakdown-list { display: flex; flex-direction: column; gap: 0.6rem; }
    .breakdown-row { display: flex; align-items: center; gap: 0.75rem; }
    .breakdown-name { font-family: var(--font-body); font-size: 0.82rem; color: var(--text); min-width: 180px; }
    .breakdown-bar-track { flex: 1; height: 8px; background: rgba(255,255,255,0.06); border-radius: 4px; overflow: hidden; }
    .breakdown-bar { height: 100%; background: var(--gold); border-radius: 4px; transition: width 0.3s ease; }
    .breakdown-count { font-family: var(--font-body); font-size: 0.82rem; color: var(--gold); font-weight: 600; min-width: 40px; text-align: right; }
</style>

@code {
    private ActivityChartDto? _chart;
    private bool _loading;
    private string? _error;

    private DateTime _from = DateTime.Today.AddDays(-29);
    private DateTime _to   = DateTime.Today;
    private string _groupBy = "day";
    private string _filterEventType = "";
    private string _filterActorSearch = "";
    private string _activePreset = "Last 30 Days";

    private record Preset(string Label, int Days, string GroupBy);
    private readonly List<Preset> _presets =
    [
        new("Last 7 Days",  7,   "day"),
        new("Last 30 Days", 30,  "day"),
        new("Last 90 Days", 90,  "day"),
        new("Last Year",    365, "month"),
    ];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        if (!await AuthService.IsAuthenticatedAsync())
        {
            Navigation.NavigateTo("/login");
            return;
        }
        if (!await AuthService.HasPermissionAsync(Domain.Shared.Claims.Permissions.Analytics.View))
        {
            Navigation.NavigateTo("/");
            return;
        }

        await LoadChart();
        StateHasChanged();
    }

    private async Task ApplyPreset(Preset preset)
    {
        _activePreset = preset.Label;
        _from         = DateTime.Today.AddDays(-(preset.Days - 1));
        _to           = DateTime.Today;
        _groupBy      = preset.GroupBy;
        await LoadChart();
        StateHasChanged();
    }

    private async Task LoadChart()
    {
        _loading = true;
        _error   = null;

        TelemetryEventType? evType = null;
        if (!string.IsNullOrEmpty(_filterEventType) && Enum.TryParse<TelemetryEventType>(_filterEventType, out var parsed))
            evType = parsed;

        var result = await AnalyticsService.GetChartAsync(
            _from,
            _to.AddDays(1).AddSeconds(-1),
            _groupBy,
            evType,
            string.IsNullOrEmpty(_filterActorSearch) ? null : _filterActorSearch);

        _loading = false;
        if (result.IsSuccess) _chart = result.Value;
        else _error = result.Error.Message;
    }

    private static bool ShouldShowLabel(DateTime date, int totalPoints)
    {
        if (totalPoints <= 14) return true;
        if (totalPoints <= 31) return date.Day % 7 == 1 || date.Day == 1;
        if (totalPoints <= 92) return date.Day == 1;
        return date.Month % 3 == 1 && date.Day == 1;
    }
}
